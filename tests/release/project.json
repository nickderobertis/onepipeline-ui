{
  "name": "onepipeline-ui-release",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["scope:tooling", "type:test", "lang:javascript"],
  "namedInputs": {
    "releaseMachinery": [
      "{projectRoot}/**/*",
      "apiServerSurface",
      "embeddedView",
      "sharedGlobals",
      "{workspaceRoot}/justfile",
      "{workspaceRoot}/pyproject.toml",
      "{workspaceRoot}/README.md",
      "{workspaceRoot}/LICENSE",
      "{workspaceRoot}/CHANGELOG.md",
      "{workspaceRoot}/docs/contract.md",
      "{workspaceRoot}/release-plz.toml",
      "{workspaceRoot}/release-targets.toml",
      "{workspaceRoot}/npm/**/*",
      "{workspaceRoot}/scripts/release.mjs",
      "{workspaceRoot}/scripts/release-package.py",
      "{workspaceRoot}/scripts/verify-staged-release.mjs",
      "{workspaceRoot}/scripts/build-linux-wheel.sh",
      "{workspaceRoot}/tests/fixtures/manylinux2014_*-yum.repos.d/*",
      "{workspaceRoot}/scripts/npm-build.mjs",
      "{workspaceRoot}/scripts/publish-npm.sh",
      "{workspaceRoot}/scripts/retry-install.sh",
      "{workspaceRoot}/scripts/smoke-published.sh",
      "{workspaceRoot}/scripts/release-probe.sh",
      "{workspaceRoot}/scripts/release-status.sh",
      "{workspaceRoot}/.github/workflows/release.yml",
      "{workspaceRoot}/.github/workflows/release-plz.yml",
      "{workspaceRoot}/.github/workflow-graph.mjs",
      "{workspaceRoot}/.github/fixtures/release-v0.37.0.json"
    ]
  },
  "targets": {
    "tools": {
      "command": "just release-tools",
      "cache": false
    },
    "lint": {
      "command": "node node_modules/@biomejs/biome/bin/biome check --error-on-warnings tests/release",
      "inputs": ["{projectRoot}/**/*", "sharedGlobals"]
    },
    "rehearse": {
      "//": "The manylinux build and the checks on what it staged. The staged tree is an output, because test-staged reads it (docs/linux-cold-cache-timing.md).",
      "command": "node --test --test-concurrency=1 tests/release/journeys.test.mjs",
      "dependsOn": [{ "projects": ["dag-ui"], "target": "build" }, "tools"],
      "inputs": ["releaseMachinery"],
      "outputs": ["{workspaceRoot}/target/release-journey/linux"],
      "cache": true
    },
    "test-staged": {
      "//": "The journeys over the rehearsal’s staged files, both at once: each reads that tree and writes only its own, and one target starts them together in the slot the rehearsal frees.",
      "command": "node --test --test-concurrency=2 tests/release/rehearsal-failures.test.mjs tests/release/registries.test.mjs",
      "dependsOn": [
        { "projects": ["dag-ui"], "target": "build" },
        "tools",
        "rehearse"
      ],
      "inputs": ["releaseMachinery"]
    },
    "test-standalone": {
      "//": "The release journeys that read none of the rehearsal’s files, beside it. Each stages into its own tree and serves its doubles on system-picked ports. Not check.test.mjs, which times waits and failed under the compiles running here. After dag-ui:test, whose 5 s test timeouts this need not share.",
      "command": "node --test --test-concurrency=1 tests/release/doubles.test.mjs tests/release/plan.test.mjs tests/release/release-plz.test.mjs tests/release/probe.test.mjs tests/release/staging.test.mjs tests/release/publication.test.mjs",
      "dependsOn": [
        { "projects": ["dag-ui"], "target": "build" },
        { "projects": ["dag-ui"], "target": "test" },
        "tools"
      ],
      "inputs": ["releaseMachinery"]
    },
    "test": {
      "//": "Last: check.test.mjs times waits, so it runs behind the rehearsal and the compiles beside it, and tools.test.mjs, which recreates the venv and .tools copies the others run, after it.",
      "command": "node --test --test-concurrency=1 tests/release/check.test.mjs tests/release/tools.test.mjs",
      "dependsOn": [
        { "projects": ["dag-ui"], "target": "build" },
        "tools",
        "rehearse",
        "test-staged",
        "test-standalone"
      ],
      "inputs": ["releaseMachinery"]
    },
    "check": {
      "executor": "nx:noop",
      "dependsOn": ["lint", "test", "rehearse"]
    }
  }
}
