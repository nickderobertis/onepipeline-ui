{
  "name": "onepipeline-ui-baseline",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["scope:api", "type:test", "lang:rust"],
  "targets": {
    "test-baseline": {
      "command": "just _tier-test baseline",
      "dependsOn": [
        { "projects": ["onepipeline-ui"], "target": "ensure-sibling" },
        { "projects": ["onepipeline-ui"], "target": "ensure-baseline" },
        { "projects": ["dag-ui"], "target": "build" }
      ],
      "inputs": [
        "apiServerSurface",
        "testTiers",
        "sharedGlobals",
        "{workspaceRoot}/tests/e2e/main.rs",
        "{workspaceRoot}/tests/e2e/baseline.rs",
        "{workspaceRoot}/tests/support/fixture_run.rs",
        "{workspaceRoot}/tests/support/harness_history.rs",
        "{workspaceRoot}/tests/support/http.rs",
        "{workspaceRoot}/tests/support/journal_schema.rs",
        "{workspaceRoot}/tests/support/serving.rs",
        "{workspaceRoot}/tests/support/sibling.rs",
        "{workspaceRoot}/tests/support/timeline_schema.rs",
        {
          "runtime": "git merge-base HEAD origin/main 2>/dev/null || git merge-base HEAD main"
        }
      ]
    },
    "check": {
      "executor": "nx:noop"
    }
  }
}
