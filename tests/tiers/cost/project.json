{
  "name": "onepipeline-ui-cost",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["scope:api", "type:test", "lang:rust"],
  "targets": {
    "manifest-inputs-for-affected": {
      "//": "Carries only file-based affected edges for semantic manifest inputs; CI never runs this uncached no-op.",
      "executor": "nx:noop",
      "cache": false,
      "inputs": ["cargoManifestSelection", "npmManifestSelection"],
      "outputs": []
    },
    "test-cost": {
      "command": "just _tier-test cost",
      "dependsOn": [
        {
          "projects": ["onepipeline-ui"],
          "target": "ensure-sibling"
        },
        {
          "projects": ["dag-ui"],
          "target": "build"
        }
      ],
      "inputs": [
        "apiServerSurface",
        "testTiers",
        "sharedGlobals",
        "{workspaceRoot}/tests/e2e/main.rs",
        "{workspaceRoot}/tests/e2e/cost.rs",
        "{workspaceRoot}/tests/support/cost.rs",
        "{workspaceRoot}/tests/support/fixture_run.rs",
        "{workspaceRoot}/tests/support/harness_history.rs",
        "{workspaceRoot}/tests/support/http.rs",
        "{workspaceRoot}/tests/support/journal_schema.rs",
        "{workspaceRoot}/tests/support/serving.rs",
        "{workspaceRoot}/tests/support/sibling.rs",
        "platform"
      ]
    },
    "check": {
      "executor": "nx:noop"
    }
  }
}
