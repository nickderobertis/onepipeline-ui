{
  "name": "onepipeline-ui-coverage",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["scope:api", "type:test", "lang:rust"],
  "targets": {
    "manifest-inputs-for-affected": {
      "//": "Carries only file-based affected edges for semantic manifest inputs; CI never runs this uncached no-op.",
      "executor": "nx:noop",
      "cache": false,
      "inputs": ["cargoManifestSelection"],
      "outputs": []
    },
    "coverage": {
      "command": "just _crate-coverage",
      "dependsOn": [
        {
          "projects": ["onepipeline-ui"],
          "target": "test"
        },
        {
          "projects": ["onepipeline-ui-e2e"],
          "target": "test"
        },
        {
          "projects": ["onepipeline-ui-repo-tooling"],
          "target": "test"
        },
        {
          "projects": ["onepipeline-ui-npm-launcher"],
          "target": "test"
        },
        {
          "projects": ["onepipeline-ui-versions"],
          "target": "test"
        }
      ],
      "inputs": [
        "apiServerSurface",
        "testTiers",
        "{workspaceRoot}/tests/**/*.rs",
        "platform"
      ]
    },
    "check": {
      "executor": "nx:noop"
    }
  }
}
