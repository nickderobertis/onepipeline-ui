{
  "name": "onepipeline-ui-nx-worker-startup",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["scope:tooling", "type:test", "lang:rust"],
  "namedInputs": {
    "workerGraph": [
      "{projectRoot}/**/*",
      "sharedGlobals",
      "testTiers",
      "cargoVersionFree",
      "{workspaceRoot}/**/project.json",
      "{workspaceRoot}/scripts/nx.sh",
      "{workspaceRoot}/scripts/workspace-install.sh",
      "{workspaceRoot}/scripts/nx-remote-cache.mjs",
      "{workspaceRoot}/scripts/nx-version-free-inputs.mjs",
      "{workspaceRoot}/tests/e2e/main.rs",
      "{workspaceRoot}/tests/e2e/nx_worker_startup.rs",
      "{workspaceRoot}/tests/e2e/ensure_sibling.rs",
      "{workspaceRoot}/tests/support/stub_bin.rs",
      "{workspaceRoot}/tests/fixtures/nx/delay-worker-load.mjs"
    ]
  },
  "targets": {
    "manifest-inputs-for-affected": {
      "//": "Carries only file-based affected edges for semantic manifest inputs; CI never runs this uncached no-op.",
      "executor": "nx:noop",
      "cache": false,
      "inputs": ["cargoManifestSelection", "npmManifestSelection"],
      "outputs": []
    },
    "test": {
      "command": "just _tier-test nx-worker-startup",
      "//": "Shares the e2e binary and Cargo target directory with the other tiers: build the embedded view first to avoid replacing their binary with a bundle-less build.",
      "dependsOn": [
        {
          "projects": ["dag-ui"],
          "target": "build"
        }
      ],
      "inputs": ["workerGraph", "platform"]
    },
    "test-quick": {
      "command": "just _tier-test nx-worker-startup",
      "//": "Shares the e2e binary and Cargo target directory with the other tiers: build the embedded view first to avoid replacing their binary with a bundle-less build.",
      "dependsOn": [
        {
          "projects": ["dag-ui"],
          "target": "build"
        }
      ],
      "inputs": ["workerGraph", "platform"]
    },
    "check": {
      "executor": "nx:noop"
    }
  }
}
