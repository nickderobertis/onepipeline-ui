{
  "name": "onepipeline-ui-judged-tier",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["scope:api", "type:test", "lang:rust"],
  "targets": {
    "manifest-inputs-for-affected": {
      "//": "Carries only file-based affected edges for semantic manifest inputs; CI never runs this uncached no-op.",
      "executor": "nx:noop",
      "cache": false,
      "inputs": ["cargoManifestSelection", "npmManifestSelection"],
      "outputs": []
    },
    "test": {
      "command": "just _tier-test judged-tier",
      "dependsOn": [
        {
          "projects": ["dag-ui"],
          "target": "build"
        }
      ],
      "inputs": [
        "apiServerSurface",
        "{workspaceRoot}/tests/e2e/main.rs",
        "{workspaceRoot}/tests/e2e/judged_tier.rs",
        "{workspaceRoot}/.config/nextest.toml",
        "{projectRoot}/project.json",
        "{workspaceRoot}/nx.json",
        "{workspaceRoot}/project.json",
        "{workspaceRoot}/judged-diff/project.json",
        "{workspaceRoot}/justfile",
        "{workspaceRoot}/scripts/nx.sh",
        "{workspaceRoot}/scripts/nx-remote-cache.mjs",
        "{workspaceRoot}/scripts/workspace-install.sh",
        "npmVersionFree",
        "{workspaceRoot}/.gitignore",
        "{workspaceRoot}/llmlint.yml",
        "{workspaceRoot}/oneharness.toml",
        { "runtime": "llmlint fingerprint --config llmlint.yml" },
        "platform"
      ]
    },
    "check": {
      "executor": "nx:noop"
    }
  }
}
