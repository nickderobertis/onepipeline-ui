{
  "name": "onepipeline-ui-e2e",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["scope:api", "type:test", "lang:rust"],
  "targets": {
    "test": {
      "command": "just _tier-test-covered e2e",
      "dependsOn": [
        { "projects": ["onepipeline-ui"], "target": "ensure-sibling" },
        { "projects": ["dag-ui"], "target": "build" }
      ],
      "inputs": ["e2eJourneys"],
      "outputs": ["{workspaceRoot}/target/llvm-cov-target/e2e-*.profraw"]
    },
    "test-quick": {
      "command": "just _tier-test e2e",
      "dependsOn": [
        { "projects": ["onepipeline-ui"], "target": "ensure-sibling" },
        { "projects": ["dag-ui"], "target": "build" }
      ],
      "inputs": ["e2eJourneys"]
    },
    "check": {
      "executor": "nx:noop"
    }
  },
  "namedInputs": {
    "e2eJourneys": [
      "apiServerSurface",
      "embeddedView",
      "testTiers",
      "sharedGlobals",
      "{workspaceRoot}/tests/fixtures/healthz.json",
      "{workspaceRoot}/tests/e2e/main.rs",
      "{workspaceRoot}/tests/e2e/cli.rs",
      "{workspaceRoot}/tests/e2e/server.rs",
      "{workspaceRoot}/tests/e2e/ui.rs",
      "{workspaceRoot}/tests/support/fixture_run.rs",
      "{workspaceRoot}/tests/support/harness_history.rs",
      "{workspaceRoot}/tests/support/http.rs",
      "{workspaceRoot}/tests/support/journal_schema.rs",
      "{workspaceRoot}/tests/support/scratch_repo.rs",
      "{workspaceRoot}/tests/support/serving.rs",
      "{workspaceRoot}/tests/support/sibling.rs"
    ]
  }
}
