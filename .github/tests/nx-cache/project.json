{
  "name": "github-workflows-nx-cache",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["scope:tooling", "type:test", "lang:javascript"],
  "namedInputs": {
    "cacheContract": [
      "versionFreeWorkspace",
      "{workspaceRoot}/apps/dag-ui-e2e/package.json",
      "{workspaceRoot}/apps/dag-ui/package.json",
      "{workspaceRoot}/packages/dag-layout/package.json",
      "{workspaceRoot}/packages/dag-model/package.json",
      "{workspaceRoot}/packages/telemetry-client/package.json",
      "{workspaceRoot}/packages/timeline-categories/package.json"
    ]
  },
  "targets": {
    "manifest-inputs-for-affected": {
      "//": "Carries only file-based affected edges for semantic manifest inputs; CI never runs this uncached no-op.",
      "executor": "nx:noop",
      "cache": false,
      "inputs": [
        "cargoManifestSelection",
        "filesManifestSelection",
        "npmManifestSelection",
        "pythonManifestSelection"
      ],
      "outputs": []
    },
    "bootstrap": {
      "command": "bash scripts/workspace-install.sh && node .github/tests/nx-cache/setup-sidecar.mjs"
    },
    "lint": {
      "command": "node node_modules/@biomejs/biome/bin/biome check --error-on-warnings .github/tests/nx-cache",
      "inputs": ["cacheContract", "platform"]
    },
    "test": {
      "command": "node --test --test-concurrency=1 .github/tests/nx-cache/*.test.mjs",
      "inputs": [
        "cacheContract",
        "platform",
        { "runtime": "llmlint fingerprint --config llmlint.yml" },
        {
          "runtime": "git merge-base HEAD origin/main"
        },
        {
          "runtime": "git ls-files"
        },
        {
          "runtime": "git --version"
        },
        {
          "runtime": "node -p process.version"
        },
        {
          "runtime": "cargo --version"
        },
        {
          "runtime": "cargo nextest --version"
        }
      ],
      "dependsOn": [
        "bootstrap",
        {
          "projects": ["dag-ui"],
          "target": "build"
        }
      ],
      "cache": true,
      "outputs": []
    },
    "budgets": {
      "//": "Measures nothing: an edge, so `test` has a dependent. Nx starts the ready task with the most dependents first, and `test` reads the whole workspace, so it runs on every pull request for about sixteen minutes; with no dependent it started only once the crate's tiers had drained, and test-linux's timed `dag-ui-read-latency:test`, which runs with nothing beside it, then waited on it past the job's cap (run 42473859179). `budgets` because both of ci-job.sh's test-linux selections run that target (docs/linux-cold-cache-timing.md).",
      "executor": "nx:noop",
      "dependsOn": ["test"]
    },
    "check": {
      "//": "The default check's targets this project has, plus `budgets`, so test-linux's affected targets stay `check`'s selection (tests/e2e/ci_jobs.rs).",
      "executor": "nx:noop",
      "dependsOn": ["lint", "test", "budgets"]
    }
  }
}
