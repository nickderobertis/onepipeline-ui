{
  "name": "github-workflows",
  "projectType": "application",
  "tags": ["scope:tooling", "type:test", "lang:javascript"],
  "namedInputs": {
    "workflowPolicy": [
      "sharedGlobals",
      "{projectRoot}/**/*",
      "{workspaceRoot}/screencomp.toml",
      "{workspaceRoot}/release-plz.toml",
      "{workspaceRoot}/release-targets.toml",
      "{workspaceRoot}/justfile",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/npm/onepipeline-api-cli/**/*",
      "{workspaceRoot}/scripts/release.mjs",
      "{workspaceRoot}/scripts/build-linux-wheel.sh",
      "{workspaceRoot}/scripts/release-package.py",
      "{workspaceRoot}/scripts/verify-staged-release.mjs",
      "{workspaceRoot}/scripts/npm-build.mjs",
      "{workspaceRoot}/scripts/sbom.mjs",
      "{workspaceRoot}/scripts/ci-job.sh",
      "{workspaceRoot}/scripts/measure-cold-linux.sh",
      "{workspaceRoot}/scripts/measure-cold-linux.d/**/*",
      "{workspaceRoot}/scripts/ci-warm.sh",
      "{workspaceRoot}/budgets.yaml",
      "{workspaceRoot}/scripts/actions-budget-figures.sh",
      "{workspaceRoot}/scripts/gate-time.sh",
      "{workspaceRoot}/scripts/gate-time-budget.mjs",
      "{workspaceRoot}/scripts/setup-llmlint.sh",
      "{workspaceRoot}/oneharness.toml",
      "{workspaceRoot}/llmlint.yml",
      "{workspaceRoot}/judged-diff/project.json",
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/bun.lock",
      "{workspaceRoot}/**/project.json",
      "{workspaceRoot}/scripts/workspace-install.sh",
      "{workspaceRoot}/scripts/nx.sh",
      "{workspaceRoot}/tests/e2e/linked_report.rs",
      "{workspaceRoot}/Cargo.toml"
    ]
  },
  "targets": {
    "bootstrap": {
      "command": "bash scripts/workspace-install.sh"
    },
    "test": {
      "command": "node --test .github/tests/*.test.mjs",
      "dependsOn": ["bootstrap"],
      "inputs": ["workflowPolicy"],
      "cache": false
    },
    "test-installs": {
      "//": "The journeys that install from a registry — the judged-lint toolchain from PyPI through scripts/setup-llmlint.sh, and publish's onevcs from npm — behind an edge of their own, so a change elsewhere in the workflow policy does not pay for the installs. `check` reaches them.",
      "command": "node --test .github/tests/installs/*.test.mjs",
      "dependsOn": ["bootstrap"],
      "inputs": [
        "{projectRoot}/tests/installs/**/*",
        "{projectRoot}/fixtures/release-tail/**/*",
        "{projectRoot}/fixtures/judge/**/*",
        "{projectRoot}/workflows/release.yml",
        "{projectRoot}/package.json",
        "{workspaceRoot}/budgets.yaml",
        "{workspaceRoot}/scripts/actions-budget-figures.sh",
        "{workspaceRoot}/scripts/workspace-install.sh",
        "{workspaceRoot}/scripts/setup-llmlint.sh",
        "{workspaceRoot}/scripts/nx.sh",
        "{workspaceRoot}/oneharness.toml",
        "{workspaceRoot}/llmlint.yml",
        "{workspaceRoot}/justfile",
        "{workspaceRoot}/nx.json",
        "{workspaceRoot}/project.json",
        "{workspaceRoot}/judged-diff/project.json",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/bun.lock",
        "{workspaceRoot}/.gitignore"
      ],
      "cache": false
    },
    "test-ci-jobs": {
      "command": "node --test .github/tests/ci-jobs.test.mjs",
      "dependsOn": ["bootstrap"],
      "inputs": ["{projectRoot}/**/*"]
    },
    "lint": {
      "command": "node .github/lint.mjs",
      "inputs": ["workflowPolicy"],
      "dependsOn": ["bootstrap"]
    },
    "budgets": {
      "command": "node .github/check-budgets.mjs",
      "dependsOn": ["test"],
      "cache": false
    },
    "check": {
      "executor": "nx:noop",
      "dependsOn": ["lint", "budgets", "test-ci-jobs", "test-installs"]
    }
  }
}
