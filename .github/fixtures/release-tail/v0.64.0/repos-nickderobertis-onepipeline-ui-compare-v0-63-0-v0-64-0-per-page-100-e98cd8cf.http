NGELOG.md","contents_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/contents/CHANGELOG.md?ref=23f0ccda44425ed295c7b5265e8007caa53badc5","patch":"@@ -7,6 +7,12 @@ and this project adheres to [Semantic Versioning](https://semver.org/spec/v2.0.0\n \n ## [Unreleased]\n \n+## [0.64.0](https://github.com/nickderobertis/onepipeline-ui/compare/v0.63.0...v0.64.0) - 2026-11-01\n+\n+### Added\n+\n+- *(deps)* [**breaking**] link the engine whose plan store makes a create safe to retry ([#563](https://github.com/nickderobertis/onepipeline-ui/pull/563))\n+\n ## [0.62.1](https://github.com/nickderobertis/onepipeline-ui/compare/v0.62.0...v0.62.1) - 2026-10-30\n \n ### Fixed"},{"sha":"906a63bc12af07ac8d67faa841a8094b36cab45e","filename":"Cargo.lock","status":"modified","additions":18,"deletions":17,"changes":35,"blob_url":"https://github.com/nickderobertis/onepipeline-ui/blob/23f0ccda44425ed295c7b5265e8007caa53badc5/Cargo.lock","raw_url":"https://github.com/nickderobertis/onepipeline-ui/raw/23f0ccda44425ed295c7b5265e8007caa53badc5/Cargo.lock","contents_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/contents/Cargo.lock?ref=23f0ccda44425ed295c7b5265e8007caa53badc5","patch":"@@ -1676,9 +1676,9 @@ dependencies = [\n \n [[package]]\n name = \"onepipeline\"\n-version = \"0.97.0\"\n+version = \"0.97.2\"\n source = \"registry+https://github.com/rust-lang/crates.io-index\"\n-checksum = \"dd17806a10cfa11ff0247e09b4f41349000abeb80338c2bf01ff7e6e0de27534\"\n+checksum = \"6b868205a7ab56e26ea705b7537a1218f0bbf6a367b7da886c10d0952ca8b0ab\"\n dependencies = [\n  \"async-trait\",\n  \"clap\",\n@@ -1705,7 +1705,7 @@ dependencies = [\n \n [[package]]\n name = \"onepipeline-ui\"\n-version = \"0.63.0\"\n+version = \"0.64.0\"\n dependencies = [\n  \"assert_cmd\",\n  \"auditable-info\",\n@@ -1740,9 +1740,9 @@ dependencies = [\n \n [[package]]\n name = \"onetaskgraph-core\"\n-version = \"0.12.13\"\n+version = \"0.12.14\"\n source = \"registry+https://github.com/rust-lang/crates.io-index\"\n-checksum = \"d8d73eec75ee2f48eda2865ac544944fbe05b9841369a81e5cacc4f7a576137f\"\n+checksum = \"59d61155e7f185ac3ad37229c9e038f4440d6c2f470d2fee8af47d04ed57ae6d\"\n dependencies = [\n  \"async-trait\",\n  \"chrono\",\n@@ -1764,13 +1764,14 @@ dependencies = [\n  \"thiserror 2.0.21\",\n  \"tokio\",\n  \"url\",\n+ \"uuid\",\n ]\n \n [[package]]\n name = \"onetaskgraph-github-projects\"\n-version = \"0.12.13\"\n+version = \"0.12.14\"\n source = \"registry+https://github.com/rust-lang/crates.io-index\"\n-checksum = \"733fbeeb4bd171f0e40bae149328f909b4e4e646098c4534b1bb999c9c51f771\"\n+checksum = \"3d3a9212334757006ecb9d528028c308efa7853906f7e3cf53c9c0ea03ae64c6\"\n dependencies = [\n  \"async-trait\",\n  \"chrono\",\n@@ -1786,9 +1787,9 @@ dependencies = [\n \n [[package]]\n name = \"onetaskgraph-in-memory\"\n-version = \"0.12.13\"\n+version = \"0.12.14\"\n source = \"registry+https://github.com/rust-lang/crates.io-index\"\n-checksum = \"4925bc2684bc54723ad689e633fe01e498893bac7a686c07b350f6cac8ac80ff\"\n+checksum = \"e8b553a1040c90d63e2b12ac5615c323042ce688498ec07a13547f7d56813302\"\n dependencies = [\n  \"async-trait\",\n  \"chrono\",\n@@ -1800,9 +1801,9 @@ dependencies = [\n \n [[package]]\n name = \"onetaskgraph-linear\"\n-version = \"0.12.13\"\n+version = \"0.12.14\"\n source = \"registry+https://github.com/rust-lang/crates.io-index\"\n-checksum = \"31ab3fd33fb318803feedad7b703e7b7df2243cf88a2d817a0cc2551809257d3\"\n+checksum = \"126d3c6c024245e1eca93d140b8a56ca2db6ee70f98dc1b52de51adf376c170a\"\n dependencies = [\n  \"async-trait\",\n  \"chrono\",\n@@ -1816,9 +1817,9 @@ dependencies = [\n \n [[package]]\n name = \"onetaskgraph-local-md\"\n-version = \"0.12.13\"\n+version = \"0.12.14\"\n source = \"registry+https://github.com/rust-lang/crates.io-index\"\n-checksum = \"d405d4f546f550ddd3510af36617504336c93369a8006bd1973be5e6778d0f9a\"\n+checksum = \"49b99852a3e5619230fe0fe85874a802557810eff7cb78bb849ab982f7f742c2\"\n dependencies = [\n  \"async-trait\",\n  \"chrono\",\n@@ -1833,9 +1834,9 @@ dependencies = [\n \n [[package]]\n name = \"onetaskgraph-plugin-api\"\n-version = \"0.12.13\"\n+version = \"0.12.14\"\n source = \"registry+https://github.com/rust-lang/crates.io-index\"\n-checksum = \"5eeb50bdde30126ed657eea179562eb77c6abacbfdc2d946d4d34cd48ca58d4f\"\n+checksum = \"2209cef0ca27d277c14c78622abf9af5ac914809552a0e573b45ea8663edd820\"\n dependencies = [\n  \"async-trait\",\n  \"base64 0.22.1\",\n@@ -3076,9 +3077,9 @@ checksum = \"06abde3611657adf66d383f00b093d7faecc7fa57071cce2578660c9f1010821\"\n \n [[package]]\n name = \"uuid\"\n-version = \"1.24.0\"\n+version = \"1.29.0\"\n source = \"registry+https://github.com/rust-lang/crates.io-index\"\n-checksum = \"bf3923a6f5c4c6382e0b653c4117f48d631ea17f38ed86e2a828e6f7412f5239\"\n+checksum = \"4a0e2d11620c50695fe12bbbfde96b3477fe606e7284c22d505c12ce51214514\"\n dependencies = [\n  \"getrandom 0.4.3\",\n  \"js-sys\","},{"sha":"7c1532ed599753c5612a5828c9166196fd03d466","filename":"Cargo.toml","status":"modified","additions":5,"deletions":5,"changes":10,"blob_url":"https://github.com/nickderobertis/onepipeline-ui/blob/23f0ccda44425ed295c7b5265e8007caa53badc5/Cargo.toml","raw_url":"https://github.com/nickderobertis/onepipeline-ui/raw/23f0ccda44425ed295c7b5265e8007caa53badc5/Cargo.toml","contents_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/contents/Cargo.toml?ref=23f0ccda44425ed295c7b5265e8007caa53badc5","patch":"@@ -1,6 +1,6 @@\n [package]\n name = \"onepipeline-ui\"\n-version = \"0.63.0\"\n+version = \"0.64.0\"\n edition = \"2021\"\n # The floor is the engine's: a consumer cannot build this crate under a rustc\n # `onepipeline` refuses, so this moves with the `onepipeline = \"=...\"` line\n@@ -183,7 +183,7 @@ onemessagebus = \"0.9.1\"\n # The test-only sibling requirements follow its lock so the reader and fixture\n # producer share one resolution. Its native TLS requires OpenSSL's build tools (make and a C compiler).\n # Historical upgrade reasons: docs/engine-dependency-history.md.\n-onepipeline = \"=0.97.0\"\n+onepipeline = \"=0.97.2\"\n serde = { version = \"1\", features = [\"derive\"] }\n # `preserve_order` keeps JSON object keys in insertion order, which is what lets\n # a served payload round-trip byte for byte against the checked-in fixtures the\n@@ -220,7 +220,7 @@ libc = \"0.2\"\n # records reaching this crate were written by, and the tree carries one version\n # of it rather than two. The same gate on `oneagentgraph`'s vocabulary reads the\n # dependency above, which the crate now links in its own right. Exact, at the\n-# release the linked engine's lock resolves (0.96.2 requires ^0.57.4); earlier\n+# release the linked engine's lock resolves (0.97.2 requires ^0.57.4); earlier\n # moves are in docs/engine-dependency-history.md.\n onevcs = \"=0.57.4\"\n # The same library the crate links above, with the schema bundle it publishes\n@@ -241,8 +241,8 @@ predicates = \"3\"\n # provisioning a second CLI. Exact, and the release the engine pins this family\n # to, because the family is lock-step and a caret would admit a release the\n # engine cannot share: the lock then resolves the one copy it links.\n-onetaskgraph-core = \"=0.12.13\"\n-onetaskgraph-plugin-api = \"=0.12.13\"\n+onetaskgraph-core = \"=0.12.14\"\n+onetaskgraph-plugin-api = \"=0.12.14\"\n schemars = \"1\"\n # The parser `oneagentgraph` writes a member's onejudge config with, so the\n # engine-driven journey over a panel-judged member reads the provider block it was"},{"sha":"40523ac0148c42c045b7671970dc9721ecf7826d","filename":"apps/dag-ui-e2e/dag-ui-human-items.spec.ts","status":"modified","additions":11,"deletions":1,"changes":12,"blob_url":"https://github.com/nickderobertis/onepipeline-ui/blob/23f0ccda44425ed295c7b5265e8007caa53badc5/apps%2Fdag-ui-e2e%2Fdag-ui-human-items.spec.ts","raw_url":"https://github.com/nickderobertis/onepipeline-ui/raw/23f0ccda44425ed295c7b5265e8007caa53badc5/apps%2Fdag-ui-e2e%2Fdag-ui-human-items.spec.ts","contents_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/contents/apps%2Fdag-ui-e2e%2Fdag-ui-human-items.spec.ts?ref=23f0ccda44425ed295c7b5265e8007caa53badc5","patch":"@@ -679,8 +679,18 @@ test(\"the detail enumerates every blocked step the engine derived, and an open h\n   await host\n     .getByRole(\"button\", { name: \"Details: Restore the build service\" })\n     .click();\n+  // The detail says it twice by design: once in the item's meta line, and once\n+  // as the heading over the steps that hold enumerates.\n   await expect(\n-    detailPane(page).getByText(\"blocks all work on this host\", { exact: true }),\n+    detailPane(page)\n+      .getByRole(\"paragraph\")\n+      .filter({ hasText: /^blocks all work on this host$/ }),\n+  ).toBeVisible();\n+  await expect(\n+    steps.getByRole(\"heading\", {\n+      name: \"blocks all work on this host\",\n+      exact: true,\n+    }),\n   ).toBeVisible();\n   await expect(\n     detailPane(page).getByText(\"Critical\", { exact: true }),"},{"sha":"8a85000150b6e0ef44c6c4c019632fbaec378fc1","filename":"docs/engine-dependency-history.md","status":"modified","additions":11,"deletions":1,"changes":12,"blob_url":"https://github.com/nickderobertis/onepipeline-ui/blob/23f0ccda44425ed295c7b5265e8007caa53badc5/docs%2Fengine-dependency-history.md","raw_url":"https://github.com/nickderobertis/onepipeline-ui/raw/23f0ccda44425ed295c7b5265e8007caa53badc5/docs%2Fengine-dependency-history.md","contents_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/contents/docs%2Fengine-dependency-history.md?ref=23f0ccda44425ed295c7b5265e8007caa53badc5","patch":"@@ -705,6 +705,16 @@ requirements move to 0.12.13; onevcs, oneagentgraph, onejudge, onemessagebus and\n oneharness-core are unchanged, the human-item schemas are unchanged, and no MSRV\n changes. This changes the engine types carried by ApiError::from_engine and the\n other engine-typed public items.\n+0.97.2 is the engine that links onetaskgraph 0.12.14, whose store makes creates\n+safe to retry and guards its writes. A host holds this reader and its engine to\n+one linked engine and one plan store, so the browser view keeps parsing the\n+records the dispatching engine writes only once this crate links it. The\n+plan-store family and its test-only exact requirements move to 0.12.14, and\n+uuid to the 1.29.0 that onetaskgraph-core 0.12.14 requires; onevcs,\n+oneagentgraph, onejudge, onemessagebus and oneharness-core are unchanged, and no\n+route, payload or MSRV changes beyond the release `/healthz` reports. This\n+changes the engine types carried by ApiError::from_engine and the other\n+engine-typed public items.\n \n The test-only `onevcs` requirement, which the `EventKind` drift gate in\n `tests/contract.rs` reads, has followed the release each linked engine resolves:\n@@ -713,4 +723,4 @@ declares the stacking, review and landing kinds that engine relays; 0.56.3 for\n 0.79.0 (^0.56.2), which declares `publication-resumed`, which `payload::vcs`\n copies, and for 0.79.1, 0.82.0, 0.84.0, 0.84.1 and 0.85.0; 0.56.9 for 0.89.0,\n which relays each check's times; 0.56.11 for 0.90.0; 0.57.0 for 0.95.5; and\n-0.57.4 for 0.96.0 (^0.57.4), 0.96.1, 0.96.2 and 0.97.0.\n+0.57.4 for 0.96.0 (^0.57.4), 0.96.1, 0.96.2, 0.97.0 and 0.97.2."},{"sha":"88a6180d603e5cbfe76764d45bd0c8e58b047af6","filename":"tests/e2e/server.rs","status":"modified","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/nickderobertis/onepipeline-ui/blob/23f0ccda44425ed295c7b5265e8007caa53badc5/tests%2Fe2e%2Fserver.rs","raw_url":"https://github.com/nickderobertis/onepipeline-ui/raw/23f0ccda44425ed295c7b5265e8007caa53badc5/tests%2Fe2e%2Fserver.rs","contents_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/contents/tests%2Fe2e%2Fserver.rs?ref=23f0ccda44425ed295c7b5265e8007caa53badc5","patch":"@@ -16739,6 +16739,7 @@ fn launch_copied_from_plan_task_renderings(\n                 no_link: false,\n                 expect: None,\n                 statuses: Vec::new(),\n+                conditions: onetaskgraph_core::CopyConditions::default(),\n             }),\n         )\n         .expect(\"the store copies the plan\");"},{"sha":"5c341db859d4628ab2b102f40f6453280a34a0f3","filename":"tests/fixtures/healthz.json","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/nickderobertis/onepipeline-ui/blob/23f0ccda44425ed295c7b5265e8007caa53badc5/tests%2Ffixtures%2Fhealthz.json","raw_url":"https://github.com/nickderobertis/onepipeline-ui/raw/23f0ccda44425ed295c7b5265e8007caa53badc5/tests%2Ffixtures%2Fhealthz.json","contents_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/contents/tests%2Ffixtures%2Fhealthz.json?ref=23f0ccda44425ed295c7b5265e8007caa53badc5","patch":"@@ -1,4 +1,4 @@\n {\n   \"status\": \"ok\",\n-  \"onepipeline_version\": \"0.97.0\"\n+  \"onepipeline_version\": \"0.97.2\"\n }"},{"sha":"e2cef6609c8783fe40bfcc636d7b38d0b3a4be21","filename":"tests/packaging.rs","status":"modified","additions":2,"deletions":2,"changes":4,"blob_url":"https://github.com/nickderobertis/onepipeline-ui/blob/23f0ccda44425ed295c7b5265e8007caa53badc5/tests%2Fpackaging.rs","raw_url":"https://github.com/nickderobertis/onepipeline-ui/raw/23f0ccda44425ed295c7b5265e8007caa53badc5/tests%2Fpackaging.rs","contents_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/contents/tests%2Fpackaging.rs?ref=23f0ccda44425ed295c7b5265e8007caa53badc5","patch":"@@ -561,7 +561,7 @@ fn every_sibling_is_the_release_the_pinned_engine_resolves() {\n /// comparison of the two above passes for any release both moved to together —\n /// including one whose adopted runs write their plan's home nothing. It moves\n /// with the `onepipeline` pin and [`STORE_RELEASE`], as one change.\n-const ENGINE_RELEASE: &str = \"0.97.0\";\n+const ENGINE_RELEASE: &str = \"0.97.2\";\n \n /// Where the lock must resolve [`ENGINE_RELEASE`] from: crates.io, which serves\n /// the release a crates.io consumer and the sibling CLI `just bootstrap`\n@@ -728,7 +728,7 @@ fn the_same_engine_release_from_another_source_is_refused_naming_it() {\n /// a comparison of the two and still link a store whose closure handling nothing\n /// here was proven against. It moves with the `onepipeline` pin, as one change, to\n /// the store release that engine links.\n-const STORE_RELEASE: &str = \"0.12.13\";\n+const STORE_RELEASE: &str = \"0.12.14\";\n \n /// The members of the plan-store family the shipped binary cannot be without:\n /// the store itself, the plugin boundary, and the GitHub plugin a board is read"},{"sha":"78028ec7110c72fe70734dd7b59118b3f861ba77","filename":"tests/plan_copy.rs","status":"modified","additions":4,"deletions":1,"changes":5,"blob_url":"https://github.com/nickderobertis/onepipeline-ui/blob/23f0ccda44425ed295c7b5265e8007caa53badc5/tests%2Fplan_copy.rs","raw_url":"https://github.com/nickderobertis/onepipeline-ui/raw/23f0ccda44425ed295c7b5265e8007caa53badc5/tests%2Fplan_copy.rs","contents_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/contents/tests%2Fplan_copy.rs?ref=23f0ccda44425ed295c7b5265e8007caa53badc5","patch":"@@ -1,5 +1,7 @@\n //! The linked plan store's copy boundary, over real Markdown records on disk.\n-use onetaskgraph_core::{CopyItems, CopyRequest, CopyScope, GlobalId, StatusPolicy};\n+use onetaskgraph_core::{\n+    CopyConditions, CopyItems, CopyRequest, CopyScope, GlobalId, StatusPolicy,\n+};\n use std::fs;\n \n #[tokio::test]\n@@ -66,6 +68,7 @@ async fn a_copied_project_document_keeps_its_budget_fragment_at_the_destination(\n         expect: None,\n         no_link: false,\n         statuses: Vec::new(),\n+        conditions: CopyConditions::default(),\n     };\n     let plan = engine\n         .copy(&request("}]}