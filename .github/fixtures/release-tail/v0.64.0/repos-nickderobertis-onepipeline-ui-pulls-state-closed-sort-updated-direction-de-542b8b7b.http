repos/nickderobertis/onepipeline-ui/issues/424/comments"},"review_comments":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/424/comments"},"review_comment":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/424/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/statuses/0553d485b334fc9a1ac958c442bfa9049d826ba5"}},"author_association":"OWNER","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/422","id":4953963796,"node_id":"PR_kwDOTx3Fc88AAAABJ0d9FA","html_url":"https://github.com/nickderobertis/onepipeline-ui/pull/422","diff_url":"https://github.com/nickderobertis/onepipeline-ui/pull/422.diff","patch_url":"https://github.com/nickderobertis/onepipeline-ui/pull/422.patch","issue_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/422","number":422,"state":"closed","locked":false,"title":"feat(deps)!: link the engine whose plan store verifies Linear copies and homes private plans privately","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nLink onepipeline 0.82.0, retaining its onetaskgraph 0.9.2 store, so browser-adopted runs use the engine the host launches with. Add an adoption journey over a store-copied, rendered plan that checks provenance, node settlement and write-back to the copied tasks. Isolate served journeys from the host’s plan-store configuration.\n\n## Why\n\nThe browser’s adopted driver uses this binary’s linked engine, not the host’s CLI. Keeping them aligned lets the host adopt the Linear digest and private-plan homing fixes without browser-adopted runs refusing their own tasks.\n\n## Additional info\n\nBreaking Rust API dependency update: public items carry the engine’s types. The HTTP contract is unchanged; the health report now names engine 0.82.0.\n\nThe new journey exercises a local-md copy through the real adopt route under `--require-rendered true`. Linear-specific behavior is covered upstream; this repository does not serve Linear in its suite.","created_at":"2026-10-21T15:19:24Z","updated_at":"2026-10-21T17:12:04Z","closed_at":"2026-10-21T17:12:02Z","merged_at":"2026-10-21T17:12:02Z","merge_commit_sha":"3e3b60cf6c30a275906e31b8439ff57df9ca56c5","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/422/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/422/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/422/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/statuses/5435171377018dd903a62a4d328734843