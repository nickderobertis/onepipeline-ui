lls/211/comments"},"review_comment":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/211/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/statuses/af59b27ca2357c9c4d49554aaa84d71eb3969217"}},"author_association":"OWNER","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/242","id":4773727882,"node_id":"PR_kwDOTx3Fc88AAAABHIlOig","html_url":"https://github.com/nickderobertis/onepipeline-ui/pull/242","diff_url":"https://github.com/nickderobertis/onepipeline-ui/pull/242.diff","patch_url":"https://github.com/nickderobertis/onepipeline-ui/pull/242.patch","issue_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/242","number":242,"state":"closed","locked":false,"title":"feat(deps)!: link the engine whose plan store maps statuses per item kind","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nRelink the embedded engine to onepipeline 0.63.0 and pin the test store dependencies to its onetaskgraph 0.3.2 release. Routes and response shapes stay unchanged; `/healthz` reports the new engine version.\n\n## Why\n\nExampleOrg’s Linear project statuses differ from its issue states, preventing member-project creation and blocking plan copying, approval, and launch. The linked engine uses one status-mapping grammar for tasks and projects across Linear and GitHub Projects, allowing each kind its own vocabulary and rejecting unmapped statuses instead of guessing.\n\n## Additional info\n\nBreaking behavior: store configurations that previously wrote back without a status mapping can now fail during browser-adopted runs. Configure mappings for the statuses and item kinds each source writes.","created_at":"2026-10-07T13:58:10Z","updated_at":"2026-10-30T15:18:08Z","closed_at":"2026-10-07T16:21:24Z","merged_at":"2026-10-07T16:21:24Z","merge_commit_sha":"e846836c01f4e83b3ca0108053f6b4f8014b3cd6","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/242/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/242/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/242/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/statuses/372329ba209a6935807dd672cc18449e3597ef5e","head":{"label":"nickderobertis:nick/227/opui-relink-status-by-kind","ref":"nick/227/opui-relink-status-by-kind","sha":"372329ba209a6935807dd672cc18449e3597ef5e","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravat