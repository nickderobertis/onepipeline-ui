api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"merge_method":"squash","commit_title":null,"commit_message":null},"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/524","id":5029534747,"node_id":"PR_kwDOTx3Fc88AAAABK8icGw","html_url":"https://github.com/nickderobertis/onepipeline-ui/pull/524","diff_url":"https://github.com/nickderobertis/onepipeline-ui/pull/524.diff","patch_url":"https://github.com/nickderobertis/onepipeline-ui/pull/524.patch","issue_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/524","number":524,"state":"closed","locked":false,"title":"feat(deps)!: link the engine that ships its SBOM on npm, and ship the read API's SBOM in every npm platform package","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nLink onepipeline 0.95.1 and ship each platform build’s CycloneDX SBOM at `sboms/onepipeline-api.cyclonedx.json` in all four npm platform packages, including when PyPI publication is disabled. Packaging and publication reject missing or malformed SBOMs.\n\n## Why\n\nPyPI storage growth forced the consuming host to install the read API through npm. Shipping its linked dependencies lets the host verify that the reader and engine use the same engine release before adopting them together, preventing newer runs from rendering as empty.","created_at":"2026-10-27T06:18:06Z","updated_at":"2026-10-27T07:07:05Z","closed_at":"2026-10-27T07:07:03Z","merged_at":"2026-10-27T07:07:03Z","merge_commit_sha":"40e9e98591ed61178845dba8305cea3515625281","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/524/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/524/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/524/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/statuses/83eb883695c12b61e5980852851ed26da56f23bb","head":{"label":"nickderobertis:nick/517/onepipeline-ui-npm-sbom","ref":"nick/517/onepipeline-ui-npm-sbom","sha":"83eb883695c12b61e5980852851ed26da56f23bb","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/us