ll,"archived":false,"disabled":false,"open_issues_count":73,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":0,"open_issues":73,"watchers":1,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/466"},"html":{"href":"https://github.com/nickderobertis/onepipeline-ui/pull/466"},"issue":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/466"},"comments":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/466/comments"},"review_comments":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/466/comments"},"review_comment":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/466/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/statuses/d1529a5323ac98962e2a6d87dd081b45acfafbf5"}},"author_association":"OWNER","auto_merge":{"enabled_by":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"merge_method":"squash","commit_title":null,"commit_message":null},"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/465","id":5001917099,"node_id":"PR_kwDOTx3Fc88AAAABKiMyqw","html_url":"https://github.com/nickderobertis/onepipeline-ui/pull/465","diff_url":"https://github.com/nickderobertis/onepipeline-ui/pull/465.diff","patch_url":"https://github.com/nickderobertis/onepipeline-ui/pull/465.patch","issue_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/465","number":465,"state":"closed","locked":false,"title":"feat!: link the engine that holds nodes only on trackers their edges name","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nLink onepipeline 0.90.0 and plan store 0.12.0 together, so adopted runs hold nodes only on trackers their edges name and retry rate-limited sources at the provider’s reset. Keep routes and the browser view unchanged, with HTTP journey coverage for rendering and adopting both new and legacy source-held runs.\n\n## Why\n\nAdopting a run from the browser makes this service’s linked engine its driver. Matching the command-line engine prevents adopted runs from polling every private tracker once a minute and stalling on one that cannot answer.\n\n## Additional info\n\nThis is a breaking dependency upgrade because the engine’s minor release changes types exposed by this crate’s public API.\n\nSource holds remain displayed by kind. The service does not interpret `cause` or `retry_at_ms`: the engine’s `SourceHold` type and `source_held` reader are private. Exposing that typed reader would enable richer presentation without duplicating the engine’s hold schema.","created_at":"2026-10-25T04:51:47Z","updated_at":"2026-10-25T05:14:55Z","closed_at":"2026-10-25T05:14:53Z","merged_at":"2026-10-25T05:14:53Z","merge_commit_sha":"cf68d3ec82788c0702c2e5db58382725f30eea30","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/465/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/465/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/465/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/statuses/e3efd6ac934db0143738917068f56deab6873a11","head":{"label":"nickderobertis:nick/419/ui","ref":"nick/419/ui","sha":"e3efd6ac934db0143738917068f56deab6873a11","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE