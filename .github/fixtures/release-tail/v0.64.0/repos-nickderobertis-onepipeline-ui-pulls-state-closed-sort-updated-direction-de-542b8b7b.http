age ([#432](https://github.com/nickderobertis/onepipeline-ui/pull/432))\n\n### Fixed\n\n- serve the recorded agent role for observer-graph sessions ([#436](https://github.com/nickderobertis/onepipeline-ui/pull/436))\n</blockquote>\n\n\n</p></details>\n\n---\nThis PR was generated with [release-plz](https://github.com/release-plz/release-plz/).","created_at":"2026-10-22T20:36:03Z","updated_at":"2026-10-23T08:48:31Z","closed_at":"2026-10-23T08:48:29Z","merged_at":"2026-10-23T08:48:29Z","merge_commit_sha":"4bcea0b0bb780e3da34516b7dc2e2fef0825d9bf","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/435/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/435/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/435/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/statuses/67b4a3ef620e8fe4d6d5bb25dc92564058a62643","head":{"label":"nickderobertis:release-plz-2026-10-22T20-36-01Z","ref":"release-plz-2026-10-22T20-36-01Z","sha":"67b4a3ef620e8fe4d6d5bb25dc92564058a62643","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organiz