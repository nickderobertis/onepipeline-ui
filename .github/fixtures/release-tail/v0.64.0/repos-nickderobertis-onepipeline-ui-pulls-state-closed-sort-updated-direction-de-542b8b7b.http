bertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"merge_method":"squash","commit_title":null,"commit_message":null},"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/513","id":5010869221,"node_id":"PR_kwDOTx3Fc88AAAABKqvL5Q","html_url":"https://github.com/nickderobertis/onepipeline-ui/pull/513","diff_url":"https://github.com/nickderobertis/onepipeline-ui/pull/513.diff","patch_url":"https://github.com/nickderobertis/onepipeline-ui/pull/513.patch","issue_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/513","number":513,"state":"closed","locked":false,"title":"fix(deps)!: link the engine that keeps every run's observer monitor on its own config","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nRelink the read API from onepipeline 0.92.0 to 0.93.0, aligning its dependencies with the engine’s oneagentgraph 0.9.0, onejudge 0.22.0 and onetaskgraph 0.12.3.\n\nNo pages or routes change. The only response change is `/healthz` reporting the new engine version.\n\n## Why\n\nThe host needs its reader and dispatcher to use the same engine. This relink lets it adopt the engine that keeps each graph member’s worker on its own config, preventing the launch directory’s config from ending observer monitors and leaving runs unwatched against their goals.\n\n## Additional info\n\nBreaking dependency update: this crate’s public API carries engine types, so the engine version change affects downstream Rust consumers.","created_at":"2026-10-26T01:57:09Z","updated_at":"2026-10-26T02:21:50Z","closed_at":"2026-10-26T02:21:49Z","merged_at":"2026-10-26T02:21:49Z","merge_commit_sha":"9f004997fa34e808980d5a432e4394659bc1cb30","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/513/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/513/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/513/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/statuses/4f6766bb2a26daf54bb79e0f67567a5f21586d39","head":{"label":"nickderobertis:nick/505/ui-relink-agent-config","ref":"nick/505/ui-relink-agent-config","sha":"4f6766bb2a26daf54bb79e0f67567a5f21586d39","user":{"login":"nickderoberti