pos/nickderobertis/onepipeline-ui/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/530/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/statuses/0334840fa772fae5c60cba139446a889db2ee7b7"}},"author_association":"OWNER","auto_merge":{"enabled_by":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"merge_method":"squash","commit_title":null,"commit_message":null},"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/528","id":5034892508,"node_id":"PR_kwDOTx3Fc88AAAABLBpc3A","html_url":"https://github.com/nickderobertis/onepipeline-ui/pull/528","diff_url":"https://github.com/nickderobertis/onepipeline-ui/pull/528.diff","patch_url":"https://github.com/nickderobertis/onepipeline-ui/pull/528.patch","issue_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/528","number":528,"state":"closed","locked":false,"title":"fix(npm): make the npm-installed onepipeline-api command become the read API process instead of running it as a child","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nThe npm-installed `onepipeline-api` now replaces Node with the server on Linux and macOS, so callers hold the server’s own PID. On Windows, it preserves the server’s exit status, lets the console deliver Ctrl-C directly to the server for graceful shutdown, and prevents the server from surviving launcher termination.\n\nThe live telemetry regression test now waits for fixture writers to be ready and accounts for the fold’s age, removing its dependence on fast process startup.\n\n## Why\n\nThe host moved from PyPI to npm after PyPI’s project size limit blocked publication. The same child-process launcher pattern in the engine broke a parent-PID check, spawned roughly 8,500 processes, and took the host down. Fixing the read API launcher upstream removes its need for the host’s direct-binary workaround.\n\n## Additional info\n\nThe npm package now requires Node `>=22.15.0 <23 || >=23.11.0`. On Linux and macOS, a Node release without `process.execve` fails with upgrade and alternative-install guidance before starting a server.","created_at":"2026-10-27T13:41:21Z","updated_at":"2026-10-27T15:50:34Z","closed_at":"2026-10-27T15:50:31Z","merged_at":"2026-10-27T15:50:31Z","merge_commit_sha":"031d634b42af17cb7d11f464a8208eafa76574ff","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/528/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/528/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/528/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/statuses/8d226a789c5902a8d23c430080016e405f0677d3","head":{"label":"nickderobertis:nick/npm-engine-install/onepipeline-ui-npm-launcher-exec","ref":"nick/npm-engine-install/onepipeline-ui-npm-launcher-exec","sha":"8d226a789c5902a8d23c430080016e405f0677d3","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api