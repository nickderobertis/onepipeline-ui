rl":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":0,"open_issues":73,"watchers":1,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/449"},"html":{"href":"https://github.com/nickderobertis/onepipeline-ui/pull/449"},"issue":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/449"},"comments":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/449/comments"},"review_comments":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/449/comments"},"review_comment":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/449/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/statuses/b7e9ec65f332f665b7c576fc75ae376053fd94cf"}},"author_association":"OWNER","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/446","id":4991156684,"node_id":"PR_kwDOTx3Fc88AAAABKX8BzA","html_url":"https://github.com/nickderobertis/onepipeline-ui/pull/446","diff_url":"https://github.com/nickderobertis/onepipeline-ui/pull/446.diff","patch_url":"https://github.com/nickderobertis/onepipeline-ui/pull/446.patch","issue_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/446","number":446,"state":"closed","locked":false,"title":"feat(deps)!: link the engine that skips withdrawn tasks and carries live-added images","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nLink the read API to `onepipeline` 0.88.0, advancing from 0.87.1 to the engine release with adoption budget support. `/healthz` reports the new version, and packaging checks require the same engine pin.\n\n## Why\n\nKeep the read API and host dispatches on one engine release so the host can adopt the engine fixes while enforcing matching dependency pins.\n\n## Additional info\n\nThis is a breaking dependency relink because public engine types cross a 0.x minor boundary. Browser adoption remains removed, as established in [#425](https://github.com/nickderobertis/onepipeline-ui/pull/425); this change adds no browser budget control. The withdrawn-task and image changes were already linked through 0.87.1.\n\nRelated upstream work: [onepipeline#789](https://github.com/nickderobertis/onepipeline/issues/789), [onepipeline#658](https://github.com/nickderobertis/onepipeline/issues/658), [onepipeline#805](https://github.com/nickderobertis/onepipeline/issues/805), and [onetaskgraph#3084](https://github.com/nickderobertis/onetaskgraph/issues/3084).","created_at":"2026-10-24T00:55:35Z","updated_at":"2026-10-24T01:38:50Z","closed_at":"2026-10-24T01:38:48Z","merged_at":"2026-10-24T01:38:48Z","merge_commit_sha":"5c742356a850f9a8ab4b2e54c25aea0a174bd092","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/446/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/446/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/446/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/statuses/e2af4ca98886b689292725b81a8651ed880c19a4","head":{"label":"nickderobertis:nick/421/opui-relink","ref":"nick/421/opui-relink","sha":"e2af4ca98886b689292725b81a8651ed880c19a4","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"repo":{"id":1327351155,"node_id":"R_kgDOTx3Fcw","name":"onepipeline-ui","full_name":"nickderobertis/onepipeline-ui","private":false,"owner":{"l