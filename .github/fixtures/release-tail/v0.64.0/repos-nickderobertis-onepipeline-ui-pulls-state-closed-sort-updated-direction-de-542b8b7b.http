ne-ui/statuses/2c3b4d701b80a3243f0ee661547cdc311bf9ffda"}},"author_association":"OWNER","auto_merge":{"enabled_by":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"merge_method":"squash","commit_title":null,"commit_message":null},"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/440","id":4981134097,"node_id":"PR_kwDOTx3Fc88AAAABKOYTEQ","html_url":"https://github.com/nickderobertis/onepipeline-ui/pull/440","diff_url":"https://github.com/nickderobertis/onepipeline-ui/pull/440.diff","patch_url":"https://github.com/nickderobertis/onepipeline-ui/pull/440.patch","issue_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/440","number":440,"state":"closed","locked":false,"title":"fix(test): compare graph rows' scales at one instant of a live run's range","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nMake the shared graph-scale test compare every row’s axis in one browser read, so live updates between reads cannot cause false failures. Zoom and reset checks use the fixed start tick to verify that all rows reframe together, without mistaking an advancing live-end tick for a zoom.\n\n## Why\n\nThis flake blocked [release PR #435](https://github.com/nickderobertis/onepipeline-ui/pull/435), delaying the read API fix needed by [oneharness#1442](https://github.com/nickderobertis/oneharness/issues/1442) to stop repeated catalog downloads costing hosts 30–50 GB a day. Fixing the assertion preserves the required check’s coverage while removing its dependence on clock rollover.","created_at":"2026-10-23T10:07:49Z","updated_at":"2026-10-23T14:21:27Z","closed_at":"2026-10-23T14:21:25Z","merged_at":"2026-10-23T14:21:25Z","merge_commit_sha":"72f640b867a65827a8e0d5c79fa13519289b166b","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/440/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/440/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/440/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/statuses/7075e67dd0eabd3b78043d993d39fd8517684f11","head":{"label":"nickderobertis:nick/Share-one-Codex-app-server-across-dispatches-and-budget-network-data-per-launch/onepipeline-ui-zoom-one-scale-flake","ref":"nick/Share-one-Codex-app-server-across-dispatches-and-budget-network-data-per-launch/onepipeline-ui-zoom-one-scale-flake","sha":"7075e67dd0eabd3b78043d993d39fd8517684f11","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"repo":{"id":1327351155,"node_id":"R_kgDOTx3Fcw","name":"onepipeline-ui","full_name":"nickderobertis/onepipeline-ui","private":false,"owner":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"ht