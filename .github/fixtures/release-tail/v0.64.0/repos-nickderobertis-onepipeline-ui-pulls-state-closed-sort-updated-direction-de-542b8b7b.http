pi.github.com/repos/nickderobertis/onepipeline-ui/statuses/2dc6941a41d6ff2feb5a82d2680269157030be27"}},"author_association":"OWNER","auto_merge":{"enabled_by":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"merge_method":"squash","commit_title":null,"commit_message":null},"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/458","id":4997278786,"node_id":"PR_kwDOTx3Fc88AAAABKdxsQg","html_url":"https://github.com/nickderobertis/onepipeline-ui/pull/458","diff_url":"https://github.com/nickderobertis/onepipeline-ui/pull/458.diff","patch_url":"https://github.com/nickderobertis/onepipeline-ui/pull/458.patch","issue_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/458","number":458,"state":"closed","locked":false,"title":"fix(deps): link the engine whose stop ends every turn a dispatch started","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nLink onepipeline 0.89.2 so a successful stop ends node-dispatch processes, including children started during teardown, with a regression journey through the stop route. Make CLI provisioning and CI caches honor the exact engine source, and fix stamp cleanup on macOS so invalid installation paths receive the intended diagnostic.\n\n## Why\n\nStopped Codex launches must stop consuming network and quota on dispatch hosts ([oneharness#1442](https://github.com/nickderobertis/oneharness/issues/1442)). ai-orchestrator keeps its engine and this read API on one linked engine, so adopting the fix requires this reader to link it too.\n\n## Additional info\n\nThe crates.io pin to 0.89.2 replaces the interim git pin to `f06d041c5e3e398d348858207d9f8e5d9add017a`, carrying [onepipeline#1128](https://github.com/nickderobertis/onepipeline/pull/1128). That commit reported 0.89.1, whose registry release lacked the fix; the finished tree uses the released 0.89.2.","created_at":"2026-10-24T16:51:23Z","updated_at":"2026-10-24T21:41:04Z","closed_at":"2026-10-24T21:41:02Z","merged_at":"2026-10-24T21:41:02Z","merge_commit_sha":"927cc6bfe3fae68aef3d398e93f27b95203b92b0","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/458/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/458/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/458/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/statuses/f1d933222de1a7450778944cf9143fa7007c3baf","head":{"label":"nickderobertis:nick/Share-one-Codex-app-server-across-dispatches-and-budget-network-data-per-launch/onepipeline-ui-link-stop-fix","ref":"nick/Share-one-Codex-app-server-across-dispatches-and-budget-network-data-per-launch/onepipeline-ui-link-stop-fix","sha":"f1d933222de1a7450778944cf9143fa7007c3baf","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"re