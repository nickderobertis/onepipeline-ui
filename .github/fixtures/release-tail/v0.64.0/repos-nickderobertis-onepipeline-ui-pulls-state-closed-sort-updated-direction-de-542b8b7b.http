e-ui/pulls/410/comments"},"review_comment":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/410/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/statuses/9f1d3bae3190269b8c7299f6730b50fdec49bb91"}},"author_association":"OWNER","auto_merge":{"enabled_by":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"merge_method":"squash","commit_title":null,"commit_message":null},"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/409","id":4946065329,"node_id":"PR_kwDOTx3Fc88AAAABJs73sQ","html_url":"https://github.com/nickderobertis/onepipeline-ui/pull/409","diff_url":"https://github.com/nickderobertis/onepipeline-ui/pull/409.diff","patch_url":"https://github.com/nickderobertis/onepipeline-ui/pull/409.patch","issue_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/409","number":409,"state":"closed","locked":false,"title":"fix(ci): finish the Linux test job reliably inside its time limit","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nShorten cold-cache Linux CI by reusing compiled Rust dependencies, starting browser tests earlier, and running independent release journeys concurrently. Isolate concurrent SBOM generation and fix a registry-test port-file race.\n\nAdd `just measure-cold-linux` for reproducible cold-cache measurements, with input validation, cleanup safeguards and actionable failure reports.\n\n## Why\n\nCold builds repeated expensive compilation and left tests waiting behind build locks and the release rehearsal. The scheduling changes address the Linux job’s 36-minute overrun without raising its cap; the attempted CPU-weight increase was reverted because it starved frontend tests.\n\n## Additional info\n\n[Timing measurements and limitations](docs/linux-cold-cache-timing.md) record seven before/after pairs. Their median ratio estimates the affected hosted job at 28.7 minutes; the worst ratio estimates the longest hosted job at 35.2 minutes. These are local measurements extrapolated to hosted CI, not a hosted validation of the final tree.","created_at":"2026-10-21T03:44:36Z","updated_at":"2026-10-21T04:04:50Z","closed_at":"2026-10-21T04:04:48Z","merged_at":"2026-10-21T04:04:48Z","merge_commit_sha":"3ad634e6c18504b4ddfaaad3f9506605639ac61c","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/409/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/409/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/409/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/statuses/ded4d6c062e43c9aec72df7274aa2ad44fc53c23","head":{"label":"nickderobertis:nick/Share-one-Codex-app-server-across-dispatches-and-budget-network-data-per-launch/onepipeline-ui-linux-ci-overrun","ref":"nick/Share-one-Codex-app-server-across-dispatches-and-budget-network-data-per-launch/onepipeline-ui-linux-ci-overrun","sha":"ded4d6c062e43c9aec72df7274aa2ad44fc53c23","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations