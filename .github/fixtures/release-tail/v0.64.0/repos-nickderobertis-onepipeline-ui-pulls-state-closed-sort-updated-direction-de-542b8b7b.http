-ui/pull/209"},"issue":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/209"},"comments":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/209/comments"},"review_comments":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/209/comments"},"review_comment":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/209/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/statuses/bc69860ea5408d4ac08dbcaa7a5f57791037d94c"}},"author_association":"OWNER","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/211","id":4724819270,"node_id":"PR_kwDOTx3Fc88AAAABGZ8FRg","html_url":"https://github.com/nickderobertis/onepipeline-ui/pull/211","diff_url":"https://github.com/nickderobertis/onepipeline-ui/pull/211.diff","patch_url":"https://github.com/nickderobertis/onepipeline-ui/pull/211.patch","issue_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/211","number":211,"state":"closed","locked":false,"title":"fix(deps)!: follow the linked engine's surface across its incompatible versions","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nDocument that this crate’s public surface follows the linked engine’s: incompatible engine upgrades are breaking changes here because public signatures carry engine types such as `onepipeline::Error`. Announce the already-landed upgrade as breaking so it can be released. Runtime behavior is unchanged.\n\n## Why\n\nMoving ExampleOrg plans and follow-ups to Linear while keeping nickderobertis work on GitHub Projects requires the multi-source engine. The downstream integration is waiting for a onepipeline-ui release linking that engine; the missing breaking-change announcement blocks that release.","created_at":"2026-10-03T07:12:48Z","updated_at":"2026-10-30T15:18:11Z","closed_at":"2026-10-03T09:20:13Z","merged_at":"2026-10-03T09:20:13Z","merge_commit_sha":"cc1b278cd9d590268091ae4df29ab45e584a9431","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/211/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/211/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/211/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/statuses/af59b27ca2357c9c4d49554aaa84d71eb3969217","head":{"label":"nickderobertis:nick/linear-backend/ui-announce-engine-break","ref":"nick/linear-backend/ui-announce-engine-break","sha":"af59b27ca2357c9c4d49554aaa84d71eb3969217","user":{"login":"nickderobertis","i