/387/comments"},"review_comments":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/387/comments"},"review_comment":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/387/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/statuses/6551e25c02613ea5aec017324ed33496dceee5d3"}},"author_association":"OWNER","auto_merge":{"enabled_by":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"merge_method":"squash","commit_title":null,"commit_message":null},"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/386","id":4930513539,"node_id":"PR_kwDOTx3Fc88AAAABJeGqgw","html_url":"https://github.com/nickderobertis/onepipeline-ui/pull/386","diff_url":"https://github.com/nickderobertis/onepipeline-ui/pull/386.diff","patch_url":"https://github.com/nickderobertis/onepipeline-ui/pull/386.patch","issue_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/386","number":386,"state":"closed","locked":false,"title":"feat: relay publication-resumed and serve a continued rework through every route","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nAgainst main, which already links onepipeline 0.79.0 (#384, released as 0.41.0), this change adds no relink. Its net change is the payload vocabulary and coverage for the records that engine and onevcs 0.56.3 write:\n\n- **Payload kinds:** `payload::vcs::PUBLICATION_RESUMED` (`publication-resumed`) is added to the read API's copy of onevcs's relayed event kinds. `tests/contract.rs` holds that copy to `onevcs::EventKind::PublicationResumed`. `timeline-categories` files the kind under `publication`.\n- **Fixture:** the review-loop corpus (`apps/dag-ui-e2e/fixtures/review-loop.json`, `tests/support/fixture_run.rs`) now journals a resumed publication, landing-closure outcomes and a continued rework carrying the optional `replaces_head`.\n- **Route tests** (`tests/e2e/server.rs`): that journal is served through the run, results, events and timeline routes with no record refused or dropped. A rework naming `replaces_head` reads the same as one without it, since no route's contract exposes the field.\n- **Contract test:** the read-verb goldens now read free space from an empty `ONEVCS_HOME` beside their own runs root, not the operator's.\n- **Test fix:** a dag-ui unit test now releases a held run-detail response only after the app has requested it. Before, it could release before the request existed, leaving the request pending and failing `test-linux` on a loaded runner.\n\nThe Cargo.toml change is limited to comment lines naming the `publication-resumed` kind. The requirements are unchanged from main.\n\n## Why\n\nThe view a run is adopted and supervised in carries its own copy of the engine. Its read routes and browser view have to accept every record that engine and onevcs write, without refusing or dropping any.\n\n🤖 Generated with [Claude Code](https://claude.com/claude-code)\n","created_at":"2026-10-20T03:19:46Z","updated_at":"2026-10-20T04:47:03Z","closed_at":"2026-10-20T04:47:01Z","merged_at":"2026-10-20T04:47:01Z","merge_commit_sha":"b9f582ca3598725733758190f7fc25024f0c1ff7","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/386/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/386/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/386/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/statuses/0aee8752a9e803ba12cc774ba339c4f53ce1d7c5","head":{"label":"nickderobertis:nick/Rework-a-stacked-draft-project-from-review-feedback-reply-on-the-PRs-and-continue-it-from-any-host/ui-relink-2","ref":"nick/Rework-a-stacked-draft-project-from-review-feedback-reply-on-the-PRs-and-continue-it-from-any-host/ui-relink-2","sha":"0aee8752a9e803ba12cc774ba339c4f53ce1d7c5","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"repo":{"id":1327351155,"node_id":"R_kgDOTx3Fcw","name":"onepipeline-ui","full_name":"nickderobertis/onepipeline-ui","private":false,"owner":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/sub