tis/onepipeline-ui/issues/550"},"comments":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/550/comments"},"review_comments":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/550/comments"},"review_comment":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/550/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/statuses/dccde507ce2466f46854108e99582056acb73810"}},"author_association":"OWNER","auto_merge":{"enabled_by":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"merge_method":"squash","commit_title":null,"commit_message":null},"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/549","id":5080402244,"node_id":"PR_kwDOTx3Fc88AAAABLtDJRA","html_url":"https://github.com/nickderobertis/onepipeline-ui/pull/549","diff_url":"https://github.com/nickderobertis/onepipeline-ui/pull/549.diff","patch_url":"https://github.com/nickderobertis/onepipeline-ui/pull/549.patch","issue_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/549","number":549,"state":"closed","locked":false,"title":"fix(deps): link the engine whose observer keeps a stopped turn from reading as lost","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nLink the read API to onepipeline 0.96.1, carrying onejudge 0.22.1’s fix for turns cancelled by the observer graph’s own shutdown and oneagentgraph 0.9.1’s shutdown handling. `/healthz` reports the adopted engine release.\n\n## Why\n\nThe shutdown defect makes ai-orchestrator’s monitor journey fail intermittently at settlement, randomly blocking its pre-push gate and needed changes. Updating this reader lets ai-orchestrator adopt the fix while keeping its engine and read API on the same release.\n\n## Additional info\n\nCarries [onejudge#203](https://github.com/nickderobertis/onejudge/pull/203), linked into the engine by [onepipeline#1300](https://github.com/nickderobertis/onepipeline/pull/1300). Public Rust APIs expose the adopted engine’s types, including through `ApiError::from_engine`.","created_at":"2026-10-30T06:26:05Z","updated_at":"2026-10-30T06:51:22Z","closed_at":"2026-10-30T06:51:21Z","merged_at":"2026-10-30T06:51:21Z","merge_commit_sha":"f478b7d4c259b99b02d4c534441ae8be082bc52e","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/549/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/549/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/549/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/statuses/92e5f8a632d9d965a3a339178f3d0c5a249068fe","head":{"label":"nickderobertis:nick/Share-one-Codex-app-server-across-dispatches-and-budget-network-data-per-launch/onepipeline-ui-link-onejudge-cancel-fix","ref":"nick/Share-one-Codex-app-server-across-dispatches-and-budget-network-data-per-launch/onepipeline-ui-link-onejudge-cancel-fix","sha":"92e5f8a632d9d965a3a339178f3d0c5a249068fe","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","orga