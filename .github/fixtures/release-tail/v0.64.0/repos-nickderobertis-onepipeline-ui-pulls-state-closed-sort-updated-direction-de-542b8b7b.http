d":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":0,"open_issues":73,"watchers":1,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/438"},"html":{"href":"https://github.com/nickderobertis/onepipeline-ui/pull/438"},"issue":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/438"},"comments":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/438/comments"},"review_comments":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/438/comments"},"review_comment":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/438/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/statuses/dc3732bf7414ecba0779e58b25d71d2e318cccfd"}},"author_association":"OWNER","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/437","id":4978535542,"node_id":"PR_kwDOTx3Fc88AAAABKL5sdg","html_url":"https://github.com/nickderobertis/onepipeline-ui/pull/437","diff_url":"https://github.com/nickderobertis/onepipeline-ui/pull/437.diff","patch_url":"https://github.com/nickderobertis/onepipeline-ui/pull/437.patch","issue_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/437","number":437,"state":"closed","locked":false,"title":"fix(test): hold the idle-subscriber and reading-switch tests to their properties on a loaded runner","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nRemove timing races from the idle-subscriber and reading-switch tests. Idle polling is checked through observed polls and kernel sleeps within a readiness deadline; reading requests are attributed by browser issuance time relative to the switch click, so late notifications from the previous step cannot fail it.\n\n## Why\n\nThese flakes block required checks on release PRs despite unrelated changes. Fixing them preserves regression coverage and unblocks the read API release needed by [oneharness#1442](https://github.com/nickderobertis/oneharness/issues/1442), which addresses repeated plugin and model catalog downloads costing hosts 30–50 GB a day.","created_at":"2026-10-23T05:58:59Z","updated_at":"2026-10-23T06:21:04Z","closed_at":"2026-10-23T06:21:02Z","merged_at":"2026-10-23T06:21:02Z","merge_commit_sha":"5671613ddd1002fc0aa3db50631e83d16cbb9c25","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/437/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/437/comments","review_comment_url":"https://api.github.com/repo