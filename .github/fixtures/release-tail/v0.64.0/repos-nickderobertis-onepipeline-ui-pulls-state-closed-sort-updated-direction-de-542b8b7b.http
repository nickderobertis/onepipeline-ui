/milestones{/number}","notifications_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/labels{/name}","releases_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/releases{/id}","deployments_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/deployments","created_at":"2026-08-08T02:34:01Z","updated_at":"2026-11-01T03:35:35Z","pushed_at":"2026-11-01T04:31:26Z","git_url":"git://github.com/nickderobertis/onepipeline-ui.git","ssh_url":"user@example.invalid:nickderobertis/onepipeline-ui.git","clone_url":"https://github.com/nickderobertis/onepipeline-ui.git","svn_url":"https://github.com/nickderobertis/onepipeline-ui","homepage":null,"size":314622,"stargazers_count":1,"watchers_count":1,"language":"Rust","has_issues":true,"has_projects":true,"has_downloads":false,"has_wiki":true,"has_pages":true,"has_discussions":false,"forks_count":0,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":73,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":0,"open_issues":73,"watchers":1,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/558"},"html":{"href":"https://github.com/nickderobertis/onepipeline-ui/pull/558"},"issue":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/558"},"comments":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/558/comments"},"review_comments":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/558/comments"},"review_comment":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/558/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/statuses/72415a26771231bccf89cbdce3bb4312cf5689ae"}},"author_association":"OWNER","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/209","id":4723737739,"node_id":"PR_kwDOTx3Fc88AAAABGY6Eiw","html_url":"https://github.com/nickderobertis/onepipeline-ui/pull/209","diff_url":"https://github.com/nickderobertis/onepipeline-ui/pull/209.diff","patch_url":"https://github.com/nickderobertis/onepipeline-ui/pull/209.patch","issue_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/209","number":209,"state":"closed","locked":false,"title":"fix(deps): link the engine that runs a plan across member projects","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nLink onepipeline 0.60.0 and align onetaskgraph dependencies to 0.2.57, resolving one copy of each crate. Browser-adopted drivers can run one plan across its home and member projects in different sources, preserve dependencies between them, and write each settlement back where its task lives.\n\n## Why\n\nExampleOrg work belongs in Linear, while personal libraries belong on GitHub Projects. Work spanning both must remain one plan and dependency graph, with task destinations determined by repository. The browser’s retained driver links this crate’s engine, so the host needs this release to adopt that capability.\n\n## Additional info\n\nAccommodates intervening engine changes by using the SDK’s standing-word calculation for run summaries, accepting an optional `drop.reason`, and categorizing `driver-exited` as lifecycle activity. Undriven runs awaiting human action now read as paused; stopped runs read as `ENDED stopped`. The published contract remains unchanged, and screenshots and visual baselines reflect these states.\n\nAdds a server adoption journey spanning two linked `local-md` sources, checking dependency ordering, settlement metadata, successful projections, and each task’s destination without creating items in the wrong project. Its store-reader helper is compiled only on Unix, matching the journey’s platform scope.","created_at":"2026-10-03T03:23:50Z","updated_at":"2026-10-30T15:18:25Z","closed_at":"2026-10-03T06:46:05Z","merged_at":"2026-10-03T06:46:05Z","merge_commit_sha":"49f2b2c7ec488224b17a599ceb1bdeecf51ac9c3","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/209/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/209/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/209/comments","statu