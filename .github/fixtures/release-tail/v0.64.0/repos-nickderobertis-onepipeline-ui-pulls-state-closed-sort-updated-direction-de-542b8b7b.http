id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":0,"open_issues":73,"watchers":1,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/440"},"html":{"href":"https://github.com/nickderobertis/onepipeline-ui/pull/440"},"issue":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/440"},"comments":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/440/comments"},"review_comments":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/440/comments"},"review_comment":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/440/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/statuses/7075e67dd0eabd3b78043d993d39fd8517684f11"}},"author_association":"OWNER","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/443","id":4983888728,"node_id":"PR_kwDOTx3Fc88AAAABKRAbWA","html_url":"https://github.com/nickderobertis/onepipeline-ui/pull/443","diff_url":"https://github.com/nickderobertis/onepipeline-ui/pull/443.diff","patch_url":"https://github.com/nickderobertis/onepipeline-ui/pull/443.patch","issue_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/443","number":443,"state":"closed","locked":false,"title":"fix(test): capture the Graph view only once its edges are drawn","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nGraph dependencies now draw from the known layout without waiting for native node resize observations. The Graph capture and a new browser journey hold those observations back to guard against missing edges, including after resize and navigation.\n\n## Why\n\nMissing edges intermittently failed the required lint check on unrelated PRs and the release PR, delaying the read API fix needed to stop repeated Codex catalog downloads costing affected hosts 30–50 GB daily.\n\n## Additional info\n\n[Reproduction and validation](docs/graph-edge-capture-regression.md) documents why React Flow withheld edges despite loaded data and visible cards. Holding native measurements reproduced the failure in both the journey and capture before the fix; the exact scheduling condition on CI remains unconfirmed. The fixed journey passed 5/5 and Graph captures passed 15/15 under that condition.\n\nThe full gallery passed 105/105 with every image unchanged from its baseline. Changed files passed formatting, lint and judged lint; broader app lint reported an existing warning in unrelated CSS.","created_at":"2026-10-23T13:58:16Z","updated_at":"2026-10-23T14:20:37Z","closed_at":"2026-10-23T14:20:35Z","merged_at":"2026-10-23T14:20:35Z","merge_commit_sha"