robertis/onepipeline-ui/pull/509"},"issue":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/509"},"comments":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/509/comments"},"review_comments":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/509/comments"},"review_comment":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/509/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/statuses/724ef16720eefe365952d39e9b785c9a3722a301"}},"author_association":"OWNER","auto_merge":{"enabled_by":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"merge_method":"squash","commit_title":null,"commit_message":null},"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/508","id":5006088790,"node_id":"PR_kwDOTx3Fc88AAAABKmLaVg","html_url":"https://github.com/nickderobertis/onepipeline-ui/pull/508","diff_url":"https://github.com/nickderobertis/onepipeline-ui/pull/508.diff","patch_url":"https://github.com/nickderobertis/onepipeline-ui/pull/508.patch","issue_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/508","number":508,"state":"closed","locked":false,"title":"fix(deps): link the engine that ends a run's observer judge command when the run ends","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nLink onepipeline 0.91.1, which ends a settled run’s observer graph and its command judge processes. Add coverage that the read API never starts, adopts or drives a run, and make the adopted-run shutdown journey independent of host tooling and macOS temporary-path length.\n\n## Why\n\nStop Codex launches and their helpers consuming network and quota after their work ends ([oneharness#1442](https://github.com/nickderobertis/oneharness/issues/1442)). ai-orchestrator requires its engine and this read API to link the same engine before the host can adopt the fix.\n\n## Additional info\n\nThe published 0.91.1 dependency replaces the earlier [onepipeline commit 670b837](https://github.com/nickderobertis/onepipeline/commit/670b837c123d69160052034b7ee827e100056505) pin, so crates.io consumers receive the fix too. The workspace retains one `oneharness-core` resolution, and the `/healthz` fixture expects `0.91.1`. The removed browser adopt route remains removed.\n\nThe shutdown journey’s earlier 60-second wait was oneharness’s deliberate redirect-delivery deadline, before shutdown grace begins; the dispatch’s own response reported that the turn “did not end within 60s.” Whether the fixture reached that deadline depended on finding `oneharness` on the host’s PATH. It now explicitly selects an unavailable interrupt client and asserts the resulting delivery failure and grace-driven kill. Its request still allows 91 seconds: the 60-second deadline, one second of grace, and a margin of half the deadline. A separate test checks the mirrored deadline against the linked oneharness source. This fixes the pre-existing race and supersedes its earlier follow-up draft.\n\nThe [earlier macOS failure](https://github.com/nickderobertis/onepipeline-ui/actions/runs/40214960004/job/121233992247) also exposed a control-socket path exceeding macOS’s 104-byte limit; the fixture now uses a short state directory under `/tmp`. The subsequent [macOS failure](https://github.com/nickderobertis/onepipeline-ui/actions/runs/40217887877/job/121242896907) prompted the explicit interrupt-client selection so hosts exercise the same shutdown path.","created_at":"2026-10-25T15:33:19Z","updated_at":"2026-10-25T18:38:38Z","closed_at":"2026-10-25T18:38:36Z","merged_at":"2026-10-25T18:38:36Z","merge_commit_sha":"66439d07436a529f8e8c80cd90f4749e5ce28d28","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/508/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/508/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/508/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/statuses/f60bd695ba059211227f2009133bb5a265d0e870","head":{"label":"nickderobertis:nick/Share-one-Codex-app-server-across-dispatches-and-budget-network-data-per-launch/onepipeline-ui-link-observer-judge-fix","ref":"nick/Share-one-Codex-app-server-across-dispatches-and-budget-network-data-per-launch/onepipeline-ui-link-observer-judge-fix","sha":"f60bd695ba059211227f2009133bb5a265d0e870","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"repo":{"id":1327351155,"node_id":"R_kgDOTx3Fcw","name":"onepipeline-ui","full_name":"nickderobertis/onepipeline-ui","private":false,"owner":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avat