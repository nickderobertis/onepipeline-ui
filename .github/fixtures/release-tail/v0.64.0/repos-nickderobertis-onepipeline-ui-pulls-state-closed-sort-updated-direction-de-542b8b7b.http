ithub.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":0,"open_issues":73,"watchers":1,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/447"},"html":{"href":"https://github.com/nickderobertis/onepipeline-ui/pull/447"},"issue":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/447"},"comments":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/447/comments"},"review_comments":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/447/comments"},"review_comment":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/447/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/statuses/a3e540ff3e8a2debdd2900137190cc54ba409627"}},"author_association":"OWNER","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/449","id":4992574080,"node_id":"PR_kwDOTx3Fc88AAAABKZSigA","html_url":"https://github.com/nickderobertis/onepipeline-ui/pull/449","diff_url":"https://github.com/nickderobertis/onepipeline-ui/pull/449.diff","patch_url":"https://github.com/nickderobertis/onepipeline-ui/pull/449.patch","issue_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/449","number":449,"state":"closed","locked":false,"title":"fix(test): build the binary fixture change instead of reading the checkout's history","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nMake the binary-fixture measurement test create its own two-commit PNG repository, so it works regardless of checkout history while still proving the fixture is applied whole.\n\n## Why\n\nThe history lookup blocks release PR #447, which carries the engine update from #446. Removing that dependency lets releases from shallow checkouts proceed so the latest fixes can be published and adopted.\n\n## Additional info\n\nThe target test passes in a depth-1 clone, and all 13 measurement tests pass in a full clone. Removing `--binary` from the measurement script makes the target test fail; restoring it passes. Deterministic lint and judged lint passed (`20261024T044606Z-29c21`, zero findings).\n\nOriginal [CI failure](https://github.com/nickderobertis/onepipeline-ui/actions/runs/40051037437/job/120775273792).","created_at":"2026-10-24T04:47:49Z","updated_at":"2026-10-24T05:08:12Z","closed_at":"2026-10-24T05:08:10Z","merged_at":"2026-10-24T05:08:10Z","merge_commit_sha":"d8ad3a81c0669920efa80d31bc01a91dd58ab715","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/449/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/449/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/449/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/statuses/b7e9ec65f332f665b7c576fc75ae376053fd94cf","head":{"label":"nickderobertis:nick/Verify-then-resolve-every-accepted-non-crozier-follow-up-ticket/opui-history-free-test","ref":"nick/Verify-then-resolve-every-accepted-non-crozier-follow-up-ticket/opui-history-free-test","sha":"b7e9ec65f332f665b7c576fc75ae376053fd94cf","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"repo":{"id":1327351155,"node_id":"R_kgDOTx3Fcw","name":"onepipeline-ui","full_name":"nickderobertis/onepipeline-ui","private":false,"owner":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubuserconten