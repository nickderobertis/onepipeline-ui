n store, so the supervising view reads exactly the records dispatch writes. This update lets the host adopt the store that re-copies unchanged Linear plans without writing to Linear.","created_at":"2026-10-30T10:17:06Z","updated_at":"2026-10-30T12:15:59Z","closed_at":"2026-10-30T12:15:57Z","merged_at":"2026-10-30T12:15:57Z","merge_commit_sha":"e6ec4a93c9f40feac7112f61bc6b4fe9b89a0954","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/553/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/553/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/553/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/statuses/c8d31f563239a8765f408eef939ab6d4b075930b","head":{"label":"nickderobertis:nick/linear-stored-content-verification/ui-link-linear-recopy","ref":"nick/linear-stored-content-verification/ui-link-linear-recopy","sha":"c8d31f563239a8765f408eef939ab6d4b075930b","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/