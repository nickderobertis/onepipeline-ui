"all","topics":[],"visibility":"public","forks":0,"open_issues":73,"watchers":1,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/439"},"html":{"href":"https://github.com/nickderobertis/onepipeline-ui/pull/439"},"issue":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/439"},"comments":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/439/comments"},"review_comments":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/439/comments"},"review_comment":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/439/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/statuses/16847d6df9e0073755babcae3101fc89c3e94634"}},"author_association":"OWNER","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/438","id":4978796613,"node_id":"PR_kwDOTx3Fc88AAAABKMJoRQ","html_url":"https://github.com/nickderobertis/onepipeline-ui/pull/438","diff_url":"https://github.com/nickderobertis/onepipeline-ui/pull/438.diff","patch_url":"https://github.com/nickderobertis/onepipeline-ui/pull/438.patch","issue_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/438","number":438,"state":"closed","locked":false,"title":"fix(test): drill from a graph row into its node's view whichever overlapping span renders first","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nMake the graph-row drill-down test click foundation’s specific, exposed gate verification span instead of the first span sharing its name. Assert that foundation’s timeline is visible after navigation, alongside the existing URL check.\n\n## Why\n\nFix the flaky required Linux check blocking release PR #435. That release carries the read API fix needed by nickderobertis/oneharness#1442 to stop repeated plugin and model catalog downloads, which have cost dispatch hosts 30–50 GB per day.\n\n## Additional info\n\nThe report and gate verification spans share an accessible name and overlap as the live timeline’s range grows. Browser measurements reproduced spans 6.84px wide starting only 0.75px apart; a hit test at the report’s center returned the later-painted gate span. Targeting that gate explicitly removes the ambiguous selection while retaining a normal pointer click.","created_at":"2026-10-23T06:27:32Z","updated_at":"2026-10-23T06:47:53Z","closed_at":"2026-10-23T06:47:52Z","merged_at":"2026-10-23T06:47:52Z","merge_commit_sha":"9f7258f54887c5554b63df62bc7beed45e5ada97","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/438/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/438/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/438/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/statuses/dc3732bf7414ecba0779e58b25d71d2e318cccfd","head":{"label":"nickderobertis:nick/Share-one-Codex-app-server-across-dispatches-and-budget-network-data-per-launch/onepipeline-ui-graph-row-drill-flake","ref":"nick/Share-one-Codex-app-server-across-dispatches-and-budget-network-data-per-launch/onepipeline-ui-graph-row-drill-flake","sha":"dc3732bf7414ecba0779e58b25d71d2e318cccfd","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"repo":{"id":1327351155,"node_id":"R_kgDOTx3Fcw","name":"onepipeline-ui","full_name":"nickderobertis/onepipeline-ui","private":false,"owner":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"htt