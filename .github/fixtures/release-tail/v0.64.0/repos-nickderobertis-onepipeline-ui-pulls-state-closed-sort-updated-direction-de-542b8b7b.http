/onepipeline-ui/pulls/401/commits"},"statuses":{"href":"https://api.github.com/repos/nickderobertis/onepipeline-ui/statuses/eea2a0c67d9e2cbce75febc1fbdcc22f4e8c3a8f"}},"author_association":"OWNER","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/514","id":5010913641,"node_id":"PR_kwDOTx3Fc88AAAABKqx5aQ","html_url":"https://github.com/nickderobertis/onepipeline-ui/pull/514","diff_url":"https://github.com/nickderobertis/onepipeline-ui/pull/514.diff","patch_url":"https://github.com/nickderobertis/onepipeline-ui/pull/514.patch","issue_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/514","number":514,"state":"closed","locked":false,"title":"perf(deps)!: align the API with the protected-copy engine","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nickderobertis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nickderobertis/subscriptions","organizations_url":"https://api.github.com/users/nickderobertis/orgs","repos_url":"https://api.github.com/users/nickderobertis/repos","events_url":"https://api.github.com/users/nickderobertis/events{/privacy}","received_events_url":"https://api.github.com/users/nickderobertis/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What\n\nRetain onepipeline 0.93.0 and onetaskgraph 0.12.3 with aligned direct and test dependencies and exactly one engine and plan-store release. The same adoption landed in [#513](https://github.com/nickderobertis/onepipeline-ui/pull/513); after merging main, this branch has no net changes against its base. Routes, responses and browser behavior remain unchanged.\n\n## Why\n\nThe host’s DAG API must interpret run and store state through the same engine as its driver, without mismatched dependency identities.\n\n## Additional info\n\nThe dependency adoption is breaking because public Rust APIs, including `ApiError::from_engine`, expose onepipeline types whose identity changes with the upgrade.","created_at":"2026-10-26T02:03:23Z","updated_at":"2026-10-29T14:17:53Z","closed_at":"2026-10-29T14:17:53Z","merged_at":null,"merge_commit_sha":null,"assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/514/commits","review_comments_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/514/comments","review_comment_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/pulls/comments{/number}","comments_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/issues/514/comments","statuses_url":"https://api.github.com/repos/nickderobertis/onepipeline-ui/statuses/17ea96b02136459946bed587c375ec8c384113c7","head":{"label":"nickderobertis:nick/452/relink-ui-engine","ref":"nick/452/relink-ui-engine","sha":"17ea96b02136459946bed587c375ec8c384113c7","user":{"login":"nickderobertis","id":19440155,"node_id":"MDQ6VXNlcjE5NDQwMTU1","avatar_url":"https://avatars.githubusercontent.com/u/19440155?v=4","gravatar_id":"","url":"https://api.github.com/users/nickderobertis","html_url":"https://github.com/nickderobertis","followers_url":"https://api.github.com/users/nickderobertis/followers","following_url":"https://api.github.com/users/nickderobertis/following{/other_user}","gists_url":"https://api.github.com/users/nickderobertis/gists{/gist_id}","starred_url":"https://api.github.com/users/nic