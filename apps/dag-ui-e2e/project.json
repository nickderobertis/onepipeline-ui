{
  "name": "dag-ui-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/dag-ui-e2e",
  "tags": ["scope:e2e", "type:e2e"],
  "implicitDependencies": ["dag-ui"],
  "targets": {
    "test": {
      "command": "npx playwright test --config apps/dag-ui-e2e/playwright.config.ts",
      "inputs": ["default", "apiServerSurface"],
      "dependsOn": [
        {
          "projects": ["dag-ui"],
          "target": "build"
        },
        {
          "projects": ["dag-ui"],
          "target": "build-api-server"
        },
        {
          "projects": ["onepipeline-ui"],
          "target": "ensure-sibling"
        }
      ]
    },
    "test-isolation": {
      "//": "After `test`, so the browser tier has a dependent and Nx starts it before the crate tasks it queued behind (docs/linux-cold-cache-timing.md).",
      "command": "npx playwright test --config apps/dag-ui-e2e/isolation.config.ts",
      "inputs": ["default", "apiServerSurface"],
      "dependsOn": [
        "test",
        {
          "projects": ["dag-ui"],
          "target": "build"
        },
        {
          "projects": ["dag-ui"],
          "target": "build-api-server"
        },
        {
          "projects": ["onepipeline-ui"],
          "target": "ensure-sibling"
        }
      ]
    },
    "test-load": {
      "//": "Linux only: reads /proc for the server's CPU. A run is about an hour; its telemetry is what budgets reads, so it is never cached.",
      "command": "cargo build --release --locked --features bundled-ui --bin onepipeline-api && npx playwright test --config apps/dag-ui-e2e/load/load.config.ts",
      "cache": false,
      "dependsOn": [
        {
          "projects": ["dag-ui"],
          "target": "build"
        }
      ]
    },
    "budgets": {
      "//": "Telemetry-only: the budgets read what test-load recorded and measure nothing themselves.",
      "command": "node_modules/.bin/onebudgetspec check apps/dag-ui-e2e/budgets.yaml",
      "inputs": [
        "{projectRoot}/budgets.yaml",
        "{projectRoot}/request-load-budget.mjs",
        "{projectRoot}/telemetry/request-load.json"
      ],
      "cache": true
    },
    "lint": {
      "command": "node node_modules/@biomejs/biome/bin/biome check apps/dag-ui-e2e && npx eslint --max-warnings 0 apps/dag-ui-e2e"
    },
    "typecheck": {
      "command": "npx tsc -p apps/dag-ui-e2e/tsconfig.json --noEmit"
    },
    "format": {
      "command": "node node_modules/@biomejs/biome/bin/biome check --write --linter-enabled=false apps/dag-ui-e2e"
    },
    "format-check": {
      "command": "node node_modules/@biomejs/biome/bin/biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false apps/dag-ui-e2e"
    },
    "bootstrap": {
      "//": "Provision only the browser here. test and test-isolation build the API through dag-ui:build-api-server, so compilation can overlap the other test tiers.",
      "command": "npx playwright install chromium"
    },
    "check": {
      "executor": "nx:noop"
    }
  }
}
