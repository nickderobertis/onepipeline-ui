{
  "name": "dag-ui-build-cache",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": ["onepipeline-ui"],
  "tags": ["scope:app", "type:test", "lang:rust"],
  "targets": {
    "lint": {
      "command": "cargo clippy --locked --quiet --test build-cache -- -D warnings",
      "dependsOn": [
        {
          "projects": ["dag-ui"],
          "target": "build"
        }
      ],
      "cache": true,
      "inputs": [
        "apiServerSurface",
        "{workspaceRoot}/tests/build_cache.rs",
        "{projectRoot}/project.json",
        "platform"
      ]
    },
    "test": {
      "command": "cargo nextest run --locked --test build-cache --status-level fail --final-status-level fail",
      "cache": true,
      "inputs": [
        "apiServerSurface",
        "{workspaceRoot}/tests/build_cache.rs",
        "{workspaceRoot}/apps/dag-ui/**/*",
        "{workspaceRoot}/packages/dag-model/**/*",
        "npmVersionFree",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/scripts/nx.sh",
        "{projectRoot}/project.json",
        "platform"
      ]
    },
    "check": {
      "executor": "nx:noop"
    }
  }
}
