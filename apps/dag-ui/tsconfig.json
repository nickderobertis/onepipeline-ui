{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2024"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client", "vitest/globals"]
  },
  "include": [
    "src",
    "vite.config.ts",
    "playwright.config.ts",
    "isolation.config.ts",
    "screenshots.config.ts",
    "e2e",
    "e2e-isolation"
  ]
}
