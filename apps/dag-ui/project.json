{
  "name": "dag-ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/dag-ui/src",
  "tags": ["scope:app", "type:web"],
  "implicitDependencies": [
    "dag-layout",
    "dag-model",
    "telemetry-client",
    "onepipeline-ui"
  ],
  "targets": {
    "serve": {
      "command": "cd apps/dag-ui && npx vite --config vite.config.ts"
    },
    "build": {
      "command": "cd apps/dag-ui && npx vite build --config vite.config.ts",
      "outputs": ["{projectRoot}/dist"]
    },
    "build-api-server": {
      "command": "cargo build --locked --quiet --bin onepipeline-api",
      "cache": false
    },
    "lint": {
      "command": "npx biome check apps/dag-ui && npx eslint apps/dag-ui"
    },
    "test": {
      "command": "cd apps/dag-ui && npx vitest run --config vite.config.ts"
    },
    "test-browser": {
      "command": "cd apps/dag-ui && npx playwright test --config playwright.config.ts && npx playwright test --config isolation.config.ts",
      "inputs": ["default", "apiServerSurface"],
      "dependsOn": [
        "build",
        "build-api-server",
        { "projects": ["onepipeline-ui"], "target": "ensure-sibling" }
      ]
    },
    "typecheck": {
      "command": "npx tsc -p apps/dag-ui/tsconfig.json --noEmit"
    },
    "bootstrap": {
      "command": "cd apps/dag-ui && npx playwright install chromium",
      "dependsOn": ["build", "build-api-server"]
    },
    "format": {
      "command": "npx biome check --write --linter-enabled=false apps/dag-ui"
    },
    "format-check": {
      "command": "npx biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false apps/dag-ui"
    },
    "check": {
      "executor": "nx:noop"
    }
  }
}
