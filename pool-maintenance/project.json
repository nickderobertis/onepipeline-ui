{
  "name": "pool-maintenance",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["scope:tooling"],
  "targets": {
    "bootstrap": {
      "command": "just _ensure-pruner"
    },
    "budgets-host": {
      "command": "node_modules/.bin/onebudgetspec check pool-maintenance/budgets.yaml --label host",
      "dependsOn": [
        "bootstrap",
        { "projects": ["onepipeline-ui"], "target": "bootstrap" },
        { "projects": ["dag-ui"], "target": "build" }
      ]
    }
  }
}
