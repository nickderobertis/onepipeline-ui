{
  "name": "pool-maintenance",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["scope:tooling"],
  "targets": {
    "bootstrap": {
      "command": "just _ensure-pruner"
    },
    "test": {
      "command": "node --test pool-maintenance/tests/*.test.mjs",
      "dependsOn": ["bootstrap"],
      "inputs": ["{projectRoot}/**/*", "{workspaceRoot}/justfile", "platform"]
    },
    "check": {
      "executor": "nx:noop",
      "dependsOn": ["test"]
    },
    "budgets-host": {
      "command": "node_modules/.bin/onebudgetspec check pool-maintenance/budgets.yaml --label host --save-results target/budget-results/pool-maintenance.json",
      "outputs": [
        "{workspaceRoot}/target/budget-results/pool-maintenance.json"
      ],
      "dependsOn": [
        "bootstrap",
        {
          "projects": ["onepipeline-ui"],
          "target": "bootstrap"
        },
        {
          "projects": ["dag-ui"],
          "target": "build"
        }
      ]
    }
  }
}
