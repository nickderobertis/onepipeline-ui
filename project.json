{
  "name": "onepipeline-ui",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "src",
  "tags": [
    "scope:api",
    "lang:rust"
  ],
  "targets": {
    "bootstrap": {
      "command": "just _crate-bootstrap"
    },
    "format": {
      "command": "just _crate-format"
    },
    "format-check": {
      "command": "just _crate-fmt-check"
    },
    "lint": {
      "command": "just _crate-lint"
    },
    "test": {
      "command": "just _crate-test"
    },
    "doc": {
      "command": "just _crate-doc"
    },
    "check": {
      "executor": "nx:noop"
    }
  }
}
