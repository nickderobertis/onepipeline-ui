{
  "name": "onepipeline-ui",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "src",
  "tags": [
    "scope:api",
    "lang:rust"
  ],
  "targets": {
    "bootstrap": {
      "command": "just _crate-bootstrap"
    },
    "ensure-sibling": {
      "command": "just _ensure-sibling",
      "cache": false
    },
    "ensure-baseline": {
      "command": "just _ensure-baseline",
      "cache": false
    },
    "format": {
      "command": "just _crate-format"
    },
    "format-check": {
      "command": "just _crate-fmt-check"
    },
    "lint": {
      "command": "just _crate-lint"
    },
    "test": {
      "command": "just _tier-test-covered unit",
      "dependsOn": [{ "projects": ["dag-ui"], "target": "build" }],
      "inputs": [
        "default",
        "servedGoldens",
        "{workspaceRoot}/apps/dag-ui/src/**/*",
        "{workspaceRoot}/apps/dag-ui-e2e/fixtures/**/*",
        "{workspaceRoot}/packages/*/src/**/*"
      ],
      "outputs": ["{workspaceRoot}/target/llvm-cov-target/unit-*.profraw"]
    },
    "test-quick": {
      "command": "just _tier-test unit",
      "dependsOn": [{ "projects": ["dag-ui"], "target": "build" }],
      "inputs": [
        "default",
        "servedGoldens",
        "{workspaceRoot}/apps/dag-ui/src/**/*",
        "{workspaceRoot}/apps/dag-ui-e2e/fixtures/**/*",
        "{workspaceRoot}/packages/*/src/**/*"
      ]
    },
    "doc": {
      "command": "just _crate-doc"
    },
    "msrv": {
      "command": "just _crate-msrv"
    },
    "deps-check": {
      "command": "just _crate-deps-check"
    },
    "lint-llm-diff": {
      "command": "bash scripts/llmlint-judge.sh",
      "options": { "cwd": "." }
    },
    "check": {
      "executor": "nx:noop"
    }
  }
}
