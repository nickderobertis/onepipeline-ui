{
  "name": "onepipeline-ui",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "src",
  "tags": [
    "scope:api",
    "lang:rust"
  ],
  "targets": {
    "bootstrap": {
      "command": "just _crate-bootstrap"
    },
    "ensure-sibling": {
      "command": "just _ensure-sibling",
      "cache": false
    },
    "ensure-baseline": {
      "command": "just _ensure-baseline",
      "cache": false
    },
    "format": {
      "command": "just _crate-format"
    },
    "format-check": {
      "command": "just _crate-fmt-check"
    },
    "lint": {
      "command": "just _crate-lint"
    },
    "test": {
      "command": "just _crate-test",
      "dependsOn": ["ensure-sibling"]
    },
    "test-baseline": {
      "command": "just _crate-test-baseline",
      "dependsOn": ["ensure-sibling", "ensure-baseline"],
      "inputs": [
        "apiServerSurface",
        "{projectRoot}/tests/e2e/main.rs",
        "{projectRoot}/tests/e2e/baseline.rs",
        "{projectRoot}/tests/support/fixture_run.rs",
        "{projectRoot}/tests/support/http.rs",
        "{projectRoot}/tests/support/serving.rs",
        "{projectRoot}/justfile",
        "sharedGlobals",
        { "runtime": "git merge-base HEAD origin/main 2>/dev/null || git merge-base HEAD main" }
      ]
    },
    "doc": {
      "command": "just _crate-doc"
    },
    "lint-llm-diff": {
      "command": "bash scripts/llmlint-judge.sh",
      "options": { "cwd": "." }
    },
    "check": {
      "executor": "nx:noop"
    }
  }
}
