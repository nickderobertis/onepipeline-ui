{
  "name": "onepipeline-ui",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "src",
  "tags": [
    "scope:api",
    "lang:rust"
  ],
  "targets": {
    "bootstrap": {
      "command": "just _crate-bootstrap"
    },
    "ensure-sibling": {
      "command": "just _ensure-sibling",
      "cache": false
    },
    "ensure-baseline": {
      "command": "just _ensure-baseline",
      "cache": false
    },
    "format": {
      "command": "just _crate-format"
    },
    "format-check": {
      "command": "just _crate-fmt-check"
    },
    "lint": {
      "command": "just _crate-lint"
    },
    // llmlint: ignore[expensive_tests_stay_behind_their_own_edge] the expense is already behind its own edge: `ensure-baseline` is a target of its own, and `scripts/ensure-baseline-api.sh` no-ops on a stamp naming the base already built, so an unrelated change pays nothing. The edge is declared here because the suite reads the artifact and must be able to require it — and the sibling edge beside it provisions a CLI at the same cost for the same reason. Splitting the journeys into a target of their own would not save the gate that build, since `check` would run that target too; it would only let `just test` pass against no baseline at all, which is the one failure `tests/e2e/baseline.rs` exists to prevent.
    "test": {
      "command": "just _crate-test",
      "dependsOn": ["ensure-sibling", "ensure-baseline"]
    },
    "doc": {
      "command": "just _crate-doc"
    },
    "lint-llm-diff": {
      "command": "bash scripts/llmlint-judge.sh",
      "options": { "cwd": "." }
    },
    "check": {
      "executor": "nx:noop"
    }
  }
}
