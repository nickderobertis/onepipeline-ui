/target
# The sibling CLI `just _ensure-sibling` provisions, pinned by the lock.
/.tools
/.dev
# The Nx orchestrator's own install and computation cache. `scripts/nx.sh`
# re-creates node_modules from the committed lockfile whenever it is missing.
/node_modules
/.nx
# Per-workspace installs, Vite's dependency cache, and the browser tier's own
# scratch. `npm ci` and the Playwright configs recreate every one of them.
node_modules/
.vite/
.vite-temp/
/apps/*/dist
/apps/*/test-results
/apps/*/playwright-report
/apps/*/.screenshots
/packages/*/dist
# Assembled by scripts/npm-build.mjs and by maturin; the committed sources are
# npm/onepipeline-api-cli/ and pyproject.toml.
/npm/dist
/dist
# Coverage instrumentation writes these wherever an instrumented binary happens
# to run, which for the e2e journeys is a temporary directory. They are raw
# counter dumps, never sources.
*.profraw
# Composed once during buildout and deliberately not committed (see AGENTS.md /
# the create-repo skill): the one-time llmlint structural tier.
llmlint.buildout.yml
REPO_PLAN.md
# Local sync bookkeeping for gh-secrets (per-machine; the manifest itself is tracked)
.gh-secrets-state.json
