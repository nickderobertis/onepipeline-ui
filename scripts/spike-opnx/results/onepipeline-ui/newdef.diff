diff --git a/scripts/cargo-manifest-digest.mjs b/scripts/cargo-manifest-digest.mjs
new file mode 100644
index 0000000..bb78a62
--- /dev/null
+++ b/scripts/cargo-manifest-digest.mjs
@@ -0,0 +1,70 @@
+#!/usr/bin/env node
+// Spike (ci-release-test-cache / spike-opnx-audit), scratch only: an Nx runtime
+// input standing for Cargo.toml and Cargo.lock with the one thing release-plz's
+// release edit changes in them blanked out — this crate's own version, in the
+// manifest's [package] table and in the lock's entry for this crate. Every other
+// byte of both files (dependency requirements, features, rust-version, every
+// third-party lock entry) still reaches the digest, so a dependency change moves
+// it and a version bump does not. Line endings are normalised so a CRLF checkout
+// (Windows, core.autocrlf) digests the same as an LF one.
+// With the argument `manifest`, only Cargo.toml is digested (for inputs that read
+// the manifest and never the lock).
+// Prints one line: the sha256 of the normalised file(s). When the version line is
+// not where it is expected it prints `raw:<sha256 of the unnormalised bytes>`
+// instead, and says so on stderr: Nx hashes a runtime input's output whatever the
+// command's exit status (measured: a failing command still yields a hash), so a
+// constant failure output would make every later edit replay. Falling back to the
+// raw bytes can only over-invalidate. An unreadable file exits 1.
+import { createHash } from "node:crypto";
+import { readFileSync } from "node:fs";
+
+const fail = (message) => {
+  console.error(`cargo-manifest-digest: ${message}`);
+  process.exit(1);
+};
+const raw = (message) => {
+  console.error(`cargo-manifest-digest: ${message}; digesting the raw bytes instead`);
+  const hash = createHash("sha256").update(manifest);
+  if (!manifestOnly) hash.update("\0").update(lock);
+  process.stdout.write(`raw:${hash.digest("hex")}\n`);
+  process.exit(0);
+};
+const read = (path) => {
+  try {
+    return readFileSync(path, "utf8").replace(/\r\n/g, "\n");
+  } catch (error) {
+    fail(`cannot read ${path}: ${error.message}`);
+  }
+};
+const manifest = read("Cargo.toml");
+const manifestOnly = process.argv[2] === "manifest";
+if (process.argv[2] !== undefined && !manifestOnly) fail(`unknown argument ${process.argv[2]}; the only one is manifest`);
+const lock = manifestOnly ? "" : read("Cargo.lock");
+
+// [package] runs from its header to the next table header.
+const pkg = manifest.match(/^\[package\]\n[\s\S]*?(?=^\[|(?![\s\S]))/m);
+if (!pkg) raw("Cargo.toml has no [package] table");
+const name = pkg[0].match(/^name = "([^"]+)"$/m)?.[1];
+if (!name) raw("Cargo.toml's [package] table names no package");
+const versionLine = /^version = "[^"]+"$/m;
+if (!versionLine.test(pkg[0])) raw("Cargo.toml's [package] table has no literal version line");
+const normalisedManifest =
+  manifest.slice(0, pkg.index) +
+  pkg[0].replace(versionLine, 'version = "<self>"') +
+  manifest.slice(pkg.index + pkg[0].length);
+
+const entry = new RegExp(
+  `^\\[\\[package\\]\\]\\nname = "${name.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}"\\nversion = "[^"]+"$`,
+  "m",
+);
+const own = manifestOnly ? [""] : lock.match(new RegExp(entry.source, "gm"));
+if (!own || own.length !== 1)
+  raw(`Cargo.lock holds ${own ? own.length : 0} entries for ${name}, not one`);
+const normalisedLock = lock.replace(
+  entry,
+  `[[package]]\nname = "${name}"\nversion = "<self>"`,
+);
+
+const hash = createHash("sha256").update(normalisedManifest);
+if (!manifestOnly) hash.update("\0").update(normalisedLock);
+process.stdout.write(`${hash.digest("hex")}\n`);
