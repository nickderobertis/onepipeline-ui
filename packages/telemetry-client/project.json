{
  "name": "telemetry-client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/telemetry-client/src",
  "tags": ["scope:shared", "type:client"],
  "implicitDependencies": ["dag-model"],
  "targets": {
    "manifest-inputs-for-affected": {
      "//": "Carries only file-based affected edges for semantic manifest inputs; CI never runs this uncached no-op.",
      "executor": "nx:noop",
      "cache": false,
      "inputs": [
        "cargoManifestSelection",
        "filesManifestSelection",
        "npmManifestSelection",
        "pythonManifestSelection"
      ],
      "outputs": []
    },
    "build": {
      "cache": false,
      "command": "node node_modules/typescript/bin/tsc -p packages/telemetry-client/tsconfig.json --emitDeclarationOnly",
      "outputs": ["{projectRoot}/dist"]
    },
    "lint": {
      "command": "node node_modules/@biomejs/biome/bin/biome check packages/telemetry-client && npx eslint --max-warnings 0 packages/telemetry-client",
      "inputs": ["manifestText"]
    },
    "test": {
      "command": "npx vitest run --root packages/telemetry-client"
    },
    "typecheck": {
      "command": "node node_modules/typescript/bin/tsc -p packages/telemetry-client/tsconfig.json --noEmit"
    },
    "format": {
      "command": "node node_modules/@biomejs/biome/bin/biome check --write --linter-enabled=false packages/telemetry-client"
    },
    "format-check": {
      "command": "node node_modules/@biomejs/biome/bin/biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false packages/telemetry-client",
      "inputs": ["manifestText"]
    },
    "check": {
      "executor": "nx:noop"
    }
  }
}
