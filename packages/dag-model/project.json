{
  "name": "dag-model",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/dag-model/src",
  "tags": ["scope:shared", "type:model"],
  "targets": {
    "build": {
      "command": "node node_modules/typescript/bin/tsc -p packages/dag-model/tsconfig.json --emitDeclarationOnly",
      "outputs": ["{projectRoot}/dist"]
    },
    "lint": {
      "command": "node node_modules/@biomejs/biome/bin/biome check packages/dag-model && npx eslint --max-warnings 0 packages/dag-model"
    },
    "test": {
      "command": "npx vitest run --root packages/dag-model",
      "inputs": [
        "default",
        "servedGoldens",
        "{workspaceRoot}/tests/fixtures/human-items/verdicts.json"
      ]
    },
    "typecheck": {
      "command": "node node_modules/typescript/bin/tsc -p packages/dag-model/tsconfig.json --noEmit"
    },
    "format": {
      "command": "node node_modules/@biomejs/biome/bin/biome check --write --linter-enabled=false packages/dag-model"
    },
    "format-check": {
      "command": "node node_modules/@biomejs/biome/bin/biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false packages/dag-model"
    },
    "check": {
      "executor": "nx:noop"
    }
  }
}
