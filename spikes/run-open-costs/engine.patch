+/// Spike prototype: each session file's activity entries, by run and index, from one
+/// parse of it, the most recent sessions kept. The stamp is the file's length and
+/// modification time, so a file that grew is parsed again.
+mod session_index {
+    use serde_json::Value;
+    use std::collections::{HashMap, VecDeque};
+    use std::path::{Path, PathBuf};
+    use std::sync::{Arc, Mutex, OnceLock};
+    use std::time::SystemTime;
+
+    type Entries = HashMap<(String, u64), Value>;
+    type Held = (u64, Option<SystemTime>, Arc<Entries>);
+    const SESSIONS: usize = 256;
+
+    #[derive(Default)]
+    struct Cache {
+        held: HashMap<PathBuf, Held>,
+        order: VecDeque<PathBuf>,
+    }
+
+    fn parsed(path: &Path) -> Option<Entries> {
+        let text = std::fs::read_to_string(path).ok()?;
+        let mut entries = HashMap::new();
+        for line in text.split_inclusive('\n') {
+            if !line.ends_with('\n') {
+                break;
+            }
+            let Ok(mut entry) = serde_json::from_str::<Value>(line.trim_end()) else {
+                continue;
+            };
+            if entry.get("type").and_then(Value::as_str) != Some("event") {
+                continue;
+            }
+            let run = entry.get("run_id").and_then(Value::as_str).map(str::to_owned);
+            let event = entry.get_mut("event").map(Value::take);
+            let at = event.as_ref().and_then(|raw| raw.get("index")).and_then(Value::as_u64);
+            if let (Some(run), Some(event), Some(at)) = (run, event, at) {
+                entries.entry((run, at)).or_insert(event);
+            }
+        }
+        Some(entries)
+    }
+
+    pub(super) fn entry(path: &Path, run: &str, index: u64) -> Option<Value> {
+        static CACHE: OnceLock<Mutex<Cache>> = OnceLock::new();
+        let about = std::fs::metadata(path).ok()?;
+        let (len, modified) = (about.len(), about.modified().ok());
+        let cache = CACHE.get_or_init(Mutex::default);
+        let mut cache = cache.lock().ok()?;
+        let fresh = cache
+            .held
+            .get(path)
+            .filter(|(held_len, held_at, _)| *held_len == len && *held_at == modified)
+            .map(|(_, _, entries)| Arc::clone(entries));
+        let entries = match fresh {
+            Some(entries) => entries,
+            None => {
+                let entries = Arc::new(parsed(path)?);
+                if cache.held.insert(path.to_path_buf(), (len, modified, Arc::clone(&entries))).is_none() {
+                    cache.order.push_back(path.to_path_buf());
+                }
+                while cache.order.len() > SESSIONS {
+                    if let Some(oldest) = cache.order.pop_front() {
+                        cache.held.remove(&oldest);
+                    }
+                }
+                entries
+            }
+        };
+        entries.get(&(run.to_owned(), index)).cloned()
+    }
+}
