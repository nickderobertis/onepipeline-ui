+fn stub_of(line: &[u8]) -> Option<Envelope> {
+    let payload = memchr::memmem::find(line, PAYLOAD)?;
+    let body = line.strip_suffix(b"]}")?;
+    let artifacts = memchr::memmem::rfind(body, ARTIFACTS)?;
+    let mut text = Vec::with_capacity(payload + 16 + line.len() - artifacts);
