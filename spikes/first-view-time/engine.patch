+thread_local! {
+    static SPIKE_SPLIT: std::cell::RefCell<Vec<(&'static str, f64)>> =
+        const { std::cell::RefCell::new(Vec::new()) };
+}
+
+/// The first-view-time spike: record `value` (seconds, or a count) for this thread's
+/// split of the read in progress.
+pub(crate) fn spike_record(name: &'static str, value: f64) {
+    SPIKE_SPLIT.with(|split| split.borrow_mut().push((name, value)));
+}
+
+/// The first-view-time spike: seconds since `since`, recorded under `name`, and now.
+pub(crate) fn spike_lap(name: &'static str, since: std::time::Instant) -> std::time::Instant {
+    let now = std::time::Instant::now();
+    spike_record(name, (now - since).as_secs_f64());
+    now
+}
+
+/// The first-view-time spike: what this thread's reads recorded, emptied.
+pub fn spike_take_split() -> Vec<(&'static str, f64)> {
+    SPIKE_SPLIT.with(|split| std::mem::take(&mut *split.borrow_mut()))
+}
