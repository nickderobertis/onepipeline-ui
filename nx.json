{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "cacheDirectory": ".nx/cache",
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/package-lock.json",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/rustfmt.toml",
      "{workspaceRoot}/clippy.toml",
      "{workspaceRoot}/biome.json",
      "{workspaceRoot}/eslint.config.mjs",
      "{workspaceRoot}/tsconfig.base.json"
    ],
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "wholeWorkspace": ["{workspaceRoot}/**/*"],
    "apiServerSurface": [
      "{workspaceRoot}/src/**/*.rs",
      "{workspaceRoot}/build.rs",
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock"
    ],
    "servedGoldens": [
      "{workspaceRoot}/tests/fixtures/*.json",
      { "runtime": "git hash-object tests/fixtures/project.json" }
    ],
    "embeddedView": [
      "{workspaceRoot}/apps/dag-ui/index.html",
      "{workspaceRoot}/apps/dag-ui/src/**/*",
      "{workspaceRoot}/apps/dag-ui/package.json",
      "{workspaceRoot}/apps/dag-ui/tsconfig.json",
      "{workspaceRoot}/apps/dag-ui/vite.config.ts",
      "{workspaceRoot}/packages/*/src/**/*",
      "{workspaceRoot}/packages/*/package.json",
      "{workspaceRoot}/packages/*/tsconfig.json"
    ],
    "testTiers": [
      "{workspaceRoot}/.config/nextest.toml",
      "{workspaceRoot}/justfile"
    ]
  },
  "targetDefaults": {
    "bootstrap": { "cache": false },
    "format": { "cache": false },
    "format-check": { "cache": true, "inputs": ["default"] },
    "lint": { "cache": true, "inputs": ["default"] },
    "typecheck": { "cache": true, "inputs": ["default"] },
    "build": { "cache": true, "inputs": ["default"] },
    "test": { "cache": true, "inputs": ["default"] },
    "test-quick": { "cache": true, "inputs": ["default"] },
    "test-baseline": { "cache": true, "inputs": ["default"] },
    "test-cost": { "cache": true, "inputs": ["default"] },
    "test-isolation": { "cache": true, "inputs": ["default"] },
    "doc": { "cache": true, "inputs": ["default"] },
    "coverage": { "cache": false },
    "msrv": { "cache": false },
    "deps-check": { "cache": false },
    "lint-llm-diff": {
      "cache": true,
      "inputs": [
        "wholeWorkspace",
        { "env": "LLMLINT_DIFF_BASE_SHA" },
        { "env": "LLMLINT_JUDGE_FINGERPRINT" },
        { "env": "LLMLINT_SHARD_BUDGET_CHARS" }
      ]
    },
    "check": {
      "cache": false,
      "dependsOn": [
        "format-check",
        "lint",
        "typecheck",
        "build",
        "test",
        "test-baseline",
        "test-cost",
        "test-isolation",
        "doc",
        "coverage"
      ]
    }
  }
}
