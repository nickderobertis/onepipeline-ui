{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "cacheDirectory": ".nx/cache",
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/package-lock.json",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/rustfmt.toml",
      "{workspaceRoot}/clippy.toml",
      "{workspaceRoot}/biome.json",
      "{workspaceRoot}/eslint.config.mjs",
      "{workspaceRoot}/tsconfig.base.json"
    ],
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "wholeWorkspace": ["{workspaceRoot}/**/*"],
    "apiServerSurface": [
      "{workspaceRoot}/src/**/*.rs",
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock"
    ],
    "servedGoldens": ["{workspaceRoot}/tests/fixtures/*.json"]
  },
  "targetDefaults": {
    "bootstrap": { "cache": false },
    "format": { "cache": false },
    "format-check": { "cache": true, "inputs": ["default"] },
    "lint": { "cache": true, "inputs": ["default"] },
    "typecheck": { "cache": true, "inputs": ["default"] },
    "build": { "cache": true, "inputs": ["default"] },
    "test": { "cache": true, "inputs": ["default"] },
    "doc": { "cache": true, "inputs": ["default"] },
    "lint-llm-diff": {
      "cache": true,
      "inputs": [
        "wholeWorkspace",
        { "env": "LLMLINT_DIFF_BASE_SHA" },
        { "env": "LLMLINT_JUDGE_FINGERPRINT" },
        { "env": "LLMLINT_SHARD_BUDGET_CHARS" }
      ]
    },
    "check": {
      "cache": false,
      "dependsOn": ["format-check", "lint", "typecheck", "build", "test", "doc"]
    }
  }
}
